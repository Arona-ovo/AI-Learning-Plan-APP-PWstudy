{
  "@platforms": [
    "android",
    "iPhone",
    "iPad"
  ],
  "id": "__UNI__53285BF",
  "name": "PWstudy",
  "version": {
    "name": "1.0 Beta",
    "code": "101"
  },
  "description": "AI 学习规划：输入远期目标自动拆解为可执行计划，番茄钟专注执行，统计学习 App 时长并动态修正计划",
  "developer": {
    "name": "",
    "email": "",
    "url": ""
  },
  "permissions": {
    "SQLite": {
      "description": "本地账号（users）"
    },
    "UniNView": {
      "description": "UniNView原生渲染"
    }
  },
  "plus": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "splashscreen": {
      "target": "id:1",
      "autoclose": true,
      "waiting": true,
      "delay": 0
    },
    "popGesture": "close",
    "launchwebview": {
      "id": "1",
      "kernel": "WKWebview"
    },
    "schemes": [
      "pwstudy"
    ],
    "darkmode": true,
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "compatible": {
      "ignoreVersion": true
    },
    "distribute": {
      "google": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.PACKAGE_USAGE_STATS\"/>",
          "<uses-permission android:name=\"android.permission.QUERY_ALL_PACKAGES\"/>",
          "<uses-permission android:name=\"android.permission.POST_NOTIFICATIONS\"/>",
          "<uses-permission android:name=\"android.permission.VIBRATE\"/>"
        ],
        "icons": {
          "mdpi": "static/icons/icon-48.png",
          "hdpi": "static/icons/icon-72.png",
          "xhdpi": "static/icons/icon-96.png",
          "xxhdpi": "static/icons/icon-144.png",
          "xxxhdpi": "static/icons/icon-192.png"
        },
        "defaultNightMode": "auto"
      },
      "apple": {
        "dSYMs": false,
        "UIUserInterfaceStyle": "Automatic"
      },
      "plugins": {
        "audio": {
          "mp3": {
            "description": "Android平台录音支持MP3格式文件"
          }
        }
      }
    },
    "statusbar": {
      "immersed": "supportedDevice",
      "style": "dark",
      "background": "#FFE4E2"
    },
    "allowsInlineMediaPlayback": true,
    "safearea": {
      "background": "#ffffff",
      "bottom": {
        "offset": "auto"
      }
    },
    "uni-app": {
      "control": "uni-v3",
      "vueVersion": "3",
      "compilerVersion": "5.26",
      "nvueCompiler": "uni-app",
      "renderer": "auto",
      "nvue": {
        "flex-direction": "column"
      },
      "nvueLaunchMode": "normal",
      "webView": {
        "minUserAgentVersion": "49.0"
      }
    },
    "tabBar": {
      "position": "bottom",
      "color": "#98a19b",
      "selectedColor": "#e11d48",
      "borderStyle": "rgba(0,0,0,0.4)",
      "blurEffect": "none",
      "fontSize": "10px",
      "iconWidth": "24px",
      "spacing": "3px",
      "height": "50px",
      "list": [
        {
          "pagePath": "pages/home/home",
          "text": "专注",
          "iconPath": "/static/tabbar/focus.png",
          "selectedIconPath": "/static/tabbar/focus-active.png"
        },
        {
          "pagePath": "pages/goals/goals",
          "text": "目标",
          "iconPath": "/static/tabbar/goals.png",
          "selectedIconPath": "/static/tabbar/goals-active.png"
        },
        {
          "pagePath": "pages/stats/stats",
          "text": "统计",
          "iconPath": "/static/tabbar/stats.png",
          "selectedIconPath": "/static/tabbar/stats-active.png"
        },
        {
          "pagePath": "pages/profile/profile",
          "text": "我的",
          "iconPath": "/static/tabbar/profile.png",
          "selectedIconPath": "/static/tabbar/profile-active.png"
        }
      ],
      "backgroundColor": "#ffffff",
      "selectedIndex": 0,
      "shown": true
    }
  },
  "app-harmony": {
    "useragent": {
      "value": "uni-app",
      "concatenate": true
    },
    "safearea": {
      "background": "#ffffff",
      "bottom": {
        "offset": "auto"
      }
    }
  },
  "locale": "zh-Hans",
  "launch_path": "__uniappview.html"
}