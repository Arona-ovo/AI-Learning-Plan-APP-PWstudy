<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="io.dcloud.uni_modules.pwstudy_focus">

    <!-- 前台服务本体（Android 9+ 要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 起前台服务必须声明类型，计时类应用用 specialUse -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 强制模式"把 PWstudy 拉回前台"要用到 moveTaskToFront（普通权限） -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- 拉回的通知带 fullScreenIntent（Android 10+ 靠它把界面直接弹到最前） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 兜底遮罩：后台启动 Activity 被 ROM 拦掉时，用悬浮窗盖住那个 App -->
    <!-- 这一条不是装机即得，要在设置里手动授「显示在其他应用上层」 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application>
        <service
            android:name="uts.sdk.modules.pwstudyFocus.PWFocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pomodoro study timer" />
        </service>

        <!-- 无障碍护卫服务（强制模式的"眼睛"与"后台启动许可"）。
             需要用户在系统设置里手动开启，属于运行时授权，不是装机即得。
             它只用来判断"当前前台是哪个应用"，不读屏幕内容、不模拟点击、不吞按键。 -->
        <service
            android:name="uts.sdk.modules.pwstudyFocus.PFGuardService"
            android:exported="true"
            android:label="@string/pw_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pw_accessibility_config" />
        </service>
    </application>
</manifest>
