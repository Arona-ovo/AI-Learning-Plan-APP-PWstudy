<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          package="com.example.dancibei">

    <!-- Android 11(targetSdk>=30) 起：与系统 TTS 引擎交互必须声明包可见性，
         否则 TextToSpeech 绑定不到 com.google.android.tts，onInit 返回 ERROR。
         注意：云端打包才会合并本文件，标准基座真机运行不生效。
         package 为占位值，云端打包时以 HBuilderX 里配置的 Android 包名为准。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 伙伴 App（背单词）：检测它装没装要用包名查，Android 11(targetSdk>=30) 起
             必须声明包可见性，否则 isApplicationExist 一律返回 false —— 表现是
             "明明装了，PWstudy 却说没装，关联入口永远不出现"。
             现在 targetSdk 还是 28 看不出问题，升到 30+ 就会静默失效，所以先占住位。
             与 AWword 侧对称（它那边已经声明了 com.pwstudy.app）。 -->
        <package android:name="com.AWword" />
    </queries>

    <application
        android:resizeableActivity="false">
        <!-- 不要重复 manifest.json 已配置的内容，避免合并冲突 -->
        <!-- ⚠️ resizeableActivity=false：专注锁屏类 App 不该被拖进分屏 / 自由窗口 ——
             否则用户在「分屏里放 PWstudy + 另一个 App」就能绕过强制模式的拉回，
             而且分屏场景会反复触发"离开"判定、连着 3 次直接把这一轮专注作废
             （用户反馈的"触发三次然后退出"正是这个）。关掉多窗口后，PWstudy 在任何设备
             上都是全屏独占，分屏这条路从系统层面就不存在了。
             代价：PWstudy 永远不能和别的 App 并排（平板上的强制多窗口系统可能仍会强制，
             那种情况下由 JS 侧的 isInMultiWindow 兜底，只拉回、不记违规）。 -->
    </application>

</manifest>
