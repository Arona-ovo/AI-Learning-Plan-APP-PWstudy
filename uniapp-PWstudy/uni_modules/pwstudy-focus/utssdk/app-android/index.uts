/**
 * pwstudy-focus（Android 实现）
 *
 * 结构参照 DCloud 官方示例 dcloudio/hello-uts 的 uts-nativepage/ForeService：
 *   · Service 子类 + onStartCommand 里建通知并 startForeground
 *   · Android 8+ 走 startForegroundService()，更老的走 startService()
 *   · onDestroy 里 stopForeground(true) 收尾
 *
 * 两件事在这个原生层做（JS 层做不到）：
 *   ① 前台服务 —— 专注期间进程不被回收，计时与结束提醒不中断；
 *   ② 后台看门狗（强制模式）—— WebView 的 setInterval 在 App 退到后台后会被系统挂起，
 *      所以"人一走就拉回来"必须由原生线程来盯；顺带用 moveTaskToFront /
 *      startActivity / 全屏意图通知 / 悬浮窗遮罩 四条手段层层兜底。
 *
 * 与 JS 侧 utils/notify.js 的配合（重要）：
 *   · 通知 id 用 8801、渠道 id 用 "pw_focus_ongoing"，与 notify.js 完全一致 ——
 *     JS 层随时可以用 NotificationManager.notify(8801, ...) 直接刷新这条通知的文案，
 *     两边写的是同一条通知，不会出现"服务一条 + JS 一条"。
 *   · 渠道重要级 LOW（= 2）：常驻倒计时不该出声，notify.js 也是这么建的。
 *   · 拉回专用通知（8803 / pw_focus_pull）是另一种东西：只在一"逃逸"时发一次，
 *     走 HIGH 渠道才能带 fullScreenIntent 把 PWstudy 直接弹到最前。
 */
import Service from 'android.app.Service';
import Activity from 'android.app.Activity';
import ActivityOptions from 'android.app.ActivityOptions';
import Intent from 'android.content.Intent';
import IBinder from 'android.os.IBinder';
import Build from 'android.os.Build';
import System from 'java.lang.System';
import Thread from 'java.lang.Thread';
import Runnable from 'java.lang.Runnable';
import Handler from 'android.os.Handler';
import Looper from 'android.os.Looper';
import Bundle from 'android.os.Bundle';
import Notification from 'android.app.Notification';
import NotificationChannel from 'android.app.NotificationChannel';
import NotificationManager from 'android.app.NotificationManager';
import Context from 'android.content.Context';
import PendingIntent from 'android.app.PendingIntent';
import NotificationCompat from 'androidx.core.app.NotificationCompat';
import ActivityManager from 'android.app.ActivityManager';
import Settings from 'android.provider.Settings';
import UsageStatsManager from 'android.app.usage.UsageStatsManager';
import UsageEvents from 'android.app.usage.UsageEvents';
import AppOpsManager from 'android.app.AppOpsManager';
import Process from 'android.os.Process';
import WindowManager from 'android.view.WindowManager';
import TextView from 'android.widget.TextView';
import ViewGroup from 'android.view.ViewGroup';
import Gravity from 'android.view.Gravity';
import Color from 'android.graphics.Color';
import PixelFormat from 'android.graphics.PixelFormat';
import GradientDrawable from 'android.graphics.drawable.GradientDrawable';
import MotionEvent from 'android.view.MotionEvent';
import AccessibilityService from 'android.accessibilityservice.AccessibilityService';
import AccessibilityEvent from 'android.view.accessibility.AccessibilityEvent';
import AccessibilityManager from 'android.view.accessibility.AccessibilityManager';
import AccessibilityServiceInfo from 'android.accessibilityservice.AccessibilityServiceInfo';
import InputMethodManager from 'android.view.inputmethod.InputMethodManager';
import SharedPreferences from 'android.content.SharedPreferences';
import NotificationListenerService from 'android.service.notification.NotificationListenerService';
import StatusBarNotification from 'android.service.notification.StatusBarNotification';
import Uri from 'android.net.Uri';
import MediaPlayer from 'android.media.MediaPlayer';
import AudioManager from 'android.media.AudioManager';
import BroadcastReceiver from 'android.content.BroadcastReceiver';
import AlarmManager from 'android.app.AlarmManager';
import JSONObject from 'org.json.JSONObject';
import Calendar from 'java.util.Calendar';

// 必须与 uniapp-PWstudy/utils/notify.js 里的 ID_ONGOING / CH_ONGOING 保持一致。
// ⚠️ 这几个常量必须显式写 : Int —— UTS 会把整数字面量推成 Number，
// 而 Android 的 startForeground(id:Int, type:Int) / PendingIntent.getActivity(..., flags:Int) /
// NotificationManager.notify(id:Int, ...) 收的是 Int，推成 Number 会编译失败
//（kotlin 编译失败：参数类型不匹配，实际 'Number' 预期 'Int'）。
const NOTIFY_ID: Int = 8801;
const CHANNEL_ID = 'pw_focus_ongoing';

// 强制模式"拉回"专用通知（与 notify.js 的 ID_ALERT = 8802 错开）
const PULL_NOTIFY_ID: Int = 8803;
const CHANNEL_PULL = 'pw_focus_pull';

// 无障碍护卫掉线提醒（2026-10-25：用户实锤"无障碍开一段时间会断"）。
// 断开应用侧救不回来 —— 无障碍开关只有用户在系统设置里能扳；能做的是
// **立刻喊人**：发一条高优先级通知，点按回 App，状态条会提示重新打开。
const GUARD_NOTIFY_ID: Int = 8804;
const CHANNEL_GUARD = 'pw_focus_guard';
const GUARD_NOTIFY_GAP_SEC: Int = 300;   // 节流：5 分钟内最多提醒一次（重绑风暴别刷屏）

// PendingIntent 标志位（数值与 android.app.PendingIntent 常量一致）
const PI_FLAGS: Int = 0x08000000 | 0x04000000;   // FLAG_UPDATE_CURRENT | FLAG_IMMUTABLE
// ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE（Android 14+ 的 specialUse 类型）
const FGS_TYPE_SPECIAL_USE: Int = 1073741824;

// 窗口类型：TYPE_APPLICATION_OVERLAY（API 26+）/ TYPE_PHONE（更老）
const WINDOW_TYPE_OVERLAY: Int = 2038;
const WINDOW_TYPE_PHONE: Int = 2002;

// 看门狗节奏。⚠️ 这些要和 escTicks / 时间戳做算术，必须显式 : Int
//（裸 const 会被推成 Number，Kotlin 里 Int 与 Number 不是一个类型，比较/传参都会编译不过）。
// 传给 Thread.sleep() 的延时不能走常量（sleep 收 Long，Int 常量不会自动放宽），
// 所以那两处直接写字面量，见 WatchLoop.run()。
const PULL_GAP_SEC: Int = 2;       // 两次"拉回"之间的最小间隔（秒），免得跟系统切前台打架
const PULL_INTERCEPT_SEC: Int = 3; // 拦截页倒计时（秒）：给用户一个明确的"要被拉回"预期，到点自动跳回
// ★ 1 = 第一次看见"非白名单前台"就动手（2026-10-24 从 2 改下来）。
//   以前留 2 是"抗抖动"：多攒一个心跳，怕用户只是路过别的 App。
//   代价是轮询那条路上凭空多等一整拍 —— 用户按 HOME 回桌面，屏幕上先**真的**出现
//   桌面，1.5~2.3 秒后拦截页才姗姗来迟，观感就是"强制模式反应慢"（用户原话：
//   "那个页面最好弹出再快一点"）。桌面现在明确算逃逸，这一拍没有存在价值了：
//   真误判的代价只是一次拉回（人还在合规 App 里的话，下一拍 seen() 就复位）。
const ESC_TICKS: Int = 1;
// 拦截页刚 startActivity 出去之后的"遮罩静默期"（秒）。
// 遮罩和拦截页都是全屏黑，谁后到谁盖住谁 —— 拦截页才是要的那条（3 秒倒数自动回），
// 遮罩只是它被 ROM 拦掉时的兜底。拉回那一拍立刻判定前台的话，拦截页还没抢到焦点，
// needOverlay() 必然为真 → 遮罩当场盖在拦截页上面，用户就得自己点一下。
// 给拦截页这段时间先把前台抢过来；真被拦掉的话静默期一过，下一拍照样上遮罩。
const INTERCEPT_GRACE_SEC: Int = 2;
const FG_WINDOW_MS: Int = 5000;    // 事件配对那条的回溯窗口（毫秒）—— 只当**辅助**用，见 queryForeground
const WATCH_MAX_SEC: Int = 43200;  // 看门狗自动收手上限：12 小时
const OVERLAY_MAX_TRIES: Int = 24; // 遮罩连续挂着的安全阀：拉回 24 次（约 50 秒）还没成功就先撤下来
// 连续几次"查不出前台是谁"才算真的瞎了（瞎了就撤遮罩收手，别把人锁在看不清的屏幕上）。
// 冷态一跳 0.6 秒（见 WatchLoop.run），50 次 ≈ 30 秒，足够趟过锁屏 / 切桌面这类短暂查不到的窗口。
// ⚠️ 这个数字是按"跳数"算的，改 WatchLoop 的节奏必须同步折算，否则静默期会缩放。
const BLIND_MAX_TICKS: Int = 50;
// 无障碍事件"静默"多久之后，不再无条件信它报上来的包名，而是拿 UsageStats 交叉验证（秒）。
//
// ⚠️ 注意它**不是**"过期就丢弃"的判据。窗口事件是"变化才发"，用户切到微信然后一直
// 停在那儿，之后根本不会再有事件 —— 早期版本拿 90 秒当过期时间，一到点就把明明正确的
// 包名判成废弃、退回 UsageStats，而 UsageStats 那条路当时只查最近 5 秒的事件（同样查
// 不到）→ 于是"人明明在微信里，我们却说查不到"，看门狗从此不再拉人。
// 这是强制模式在真机上"看着像完全没生效"的头号原因。
// 现在过期只触发"交叉验证"，不再触发"丢弃"。
const GUARD_FRESH_SEC: Int = 90;
// 无障碍服务的事件节流（毫秒）。⚠️ 要赋给 AccessibilityServiceInfo 的 Int 字段，
// 所以必须显式 : Int（裸字面量会被推成 Number，Kotlin 里 Int 与 Number 不通）
const A11Y_NOTIFY_MS: Int = 100;

/**
 * 一律放行的"中性界面"包名（逗号分隔）。这些窗口**绝不能**被当成跑偏 ——
 * 遮罩是盖全屏的，盖上去就是死锁，比"拉不回来"严重得多。
 *
 * ① 系统设置 / 权限授权页：用户正要去开「显示在其他应用上层」（强制模式的命门），
 *    遮罩一盖他就再也点不到授权开关 —— 从此强制模式永远不可能生效。
 *    这是 2026-10-14 补的：修"拉不回"之前先保证"别把人锁在门外"。
 * ② 来电 / 通话界面：接电话时挡人是要挨骂的（早期设计说明里就写了"不吞按键"）。
 * ③ 系统界面（状态栏 / 最近任务 / 分屏）：切任务那一瞬间的前台是它，
 *    当成跑偏的话，用户每次按最近任务都会被拽回来。
 */
const NEUTRAL_CSV =
  'com.android.settings,' +
  'com.android.permissioncontroller,' +
  'com.google.android.permissioncontroller,' +
  'com.android.packageinstaller,' +
  'com.android.systemui,' +
  'com.android.phone,' +
  'com.android.incallui,' +
  'com.android.server.telecom,' +
  'com.android.dialer,' +
  'com.android.mms,' +
  'com.coloros.safecenter,' +
  'com.miui.securitycenter,' +
  'com.huawei.systemmanager,' +
  'com.samsung.android.permissioncontroller,' +
  'com.android.intentresolver';

/**
 * 当前时间（秒）。
 *
 * 为什么不直接存 System.currentTimeMillis()：那是 Java 的 long，塞进 UTS 的
 * `number`/`Int` 字段都会踩类型坑（Number 与 Int 在 Kotlin 里不能直接比较）。
 * 秒级精度只用来"到点收手"和"两次拉回的间隔"，够用；纪元秒到 2038 年都在 Int 范围内。
 */
function nowSec(): Int {
  return ((System.currentTimeMillis() / 1000) as Number).toInt();
}

/* ==================== 模块级共享状态 ====================
 * Service 实例由系统创建，但类和本文件同属一个 UTS 模块，
 * 顶层 let 就是这一层共享的"单例态"：JS 侧通过下面导出的函数读。
 */
let lastTitle = 'PWstudy 专注中';   // 常驻通知文案（setWatch 那种不带文案的 Intent 不能把它冲掉）
let lastText = '';

let watchPullCount = 0;            // 拉回次数（强制模式的战绩，JS 拿来显示）
let watchEscapeCount = 0;          // 逃逸次数（连续离开学习 App 的"次"，3 次作废的依据）

let overlayWanted = false;         // 想不想挂遮罩（由看门狗线程置位，主线程消费）
let overlayView: TextView | null = null;
let mainHandler: Handler | null = null;

/* ==================== 无障碍护卫的共享状态 ====================
 * 无障碍服务（PFGuardService）由系统创建并绑定，和 PWFocusService 同进程，
 * 所以顶层变量就是两边共享的"单例态"：护卫负责报"现在前台是谁"，
 * 看门狗负责按同一套策略决定拉不拉、拉多狠。
 */
let svcRef: PWFocusService | null = null;   // 看门狗服务的实例（护卫要靠它跑同一套判定）
// 无障碍服务的实例。它提供两样东西：① **眼睛**（前台包名由系统事件直推，比轮询
// UsageStats 又快又准）② 一条"最短路径"的拉回（见 pullFromGuard 的注释）。
// ⚠️ 它**不是**"拉回来"的保证 —— 老结论"服务内 startActivity 能拿到后台启动豁免"是错的：
//    无障碍服务属于**自己 App** 的组件，不是"被另一个可见应用绑定"，AMS 照样静默拦。
//    唯一的豁免入口是 SYSTEM_ALERT_WINDOW（悬浮窗），那是准入条件，不是兜底。
let guardRef: PFGuardService | null = null;
let guardOn = false;                // 无障碍服务是否已连上（系统绑定成功）
let guardPkg = '';                  // 护卫最近一次报上来的"应用窗口"包名
let guardAtSec = 0;                 // 上报时刻（秒），过期就不再信任
let guardEvents = 0;                // 护卫累计收到的窗口事件数（诊断用）
let guardConnAtSec = 0;             // 护卫最近一次连上的时刻（判断"这次稳不稳"用）
let kickWanted = false;             // 有"人刚切走"的信号 → 让看门狗线程立刻醒一次，别等满一轮
// 拦截页刚被拉起来时的时间戳（秒）：这段时间内先别盖遮罩，让拦截页把前台抢过去。
// 见 INTERCEPT_GRACE_SEC 的注释 —— 遮罩和拦截页都是全屏黑，谁后到谁盖住谁，
// 而我们要的是拦截页（3 秒倒数自动回），遮罩只是它被 ROM 拦掉时的兜底。
// ⚠️ 必须显式 `: Int`：裸 `let x = 0` 会被推成 **Number**，而 nowSec() 返回 Int，
//    Kotlin 里 `Int < Number` 没有 compareTo 重载 → 云打包直接编译不过。
let interceptGraceUntilSec: Int = 0;

/* -------- 保险丝：服务被反复 bind = 服务在崩，不能再让它崩 --------
 *
 * 背景（真机踩出来的）：无障碍服务是**系统**创建并绑定的。用户在系统设置里一打开开关，
 * 系统就 bind 它 —— 这时候 APP 进程常常是"裸"的：uni 的 Application/Activity 还没起来，
 * UTX 运行时也没初始化过，进程里唯一活着的组件就是这个服务。
 * 服务一旦在绑定过程中抛异常，系统会：**杀掉整个 APP 进程 → 重新 bind → 再崩**，
 * 循环往复。表现不是"闪退"，而是**APP 和系统一起卡住**（system_server 也在反复重试），
 * 用户看到的就是"开了无障碍，回到 APP 就死机"。
 *
 * 所以这里记一个窗口期内的 bind 次数并落盘（进程被杀也留得下）：
 * 超过阈值就跳闸 —— 服务从此变成一个什么都不做的空壳，UI 如实告诉用户"这个 ROM 上
 * 起不来，请用严格模式 / 悬浮窗那一档"，并提供"再试一次"重置。
 * 宁可这个功能不可用，也不能把手机拖死。
 */
const A11Y_BIND_WINDOW_SEC: Int = 60;   // 统计窗口（秒）
const A11Y_BIND_MAX: Int = 2;           // 窗口内最多容忍几次 bind（第 3 次跳闸）
const A11Y_SP = 'pw_a11y';

let a11yTripped = false;    // 是否已跳闸（进程内镜像，落盘为准）
// ⚠️ 这两个必须显式 : Int —— 裸 `let x = 0` 会被 UTS 推成 **Number**，
//    而 bumpBind() 声明返回 Int，`return a11yBindN` 就成了 "expected Int, actual Number"
//    （云打包报过这条）。同理：任何要当 Int 用的顶层计数都得写类型。
let a11yBindAt: Int = 0;    // 拿不到落盘时的降级计数（进程内）
let a11yBindN: Int = 0;
let a11yListed = false;     // 后台线程刷出来的"系统启用名单里有我"
let a11yListedAt = 0;
let a11yQuerying = false;

function a11ySp(): SharedPreferences | null {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return null;
  let p = ctx!.getSharedPreferences(A11Y_SP, 0);   // 0 = MODE_PRIVATE
  return p;
}

/** 记一次 bind，返回窗口期内的累计次数（1 = 这次是第一次） */
function bumpBind(): Int {
  let t = nowSec();
  try {
    let p = a11ySp();
    if (p != null) {
      // ⚠️ 一律走 **Int 口径**（getInt/putInt），别碰 getLong/putLong：
      //   Long 回到 UTS 里是 Number，而 `Number(x)` 在生成的 Kotlin 里是
      //   **实例化抽象类 java.lang.Number** —— 编译直接挂
      //   （云打包报错：Cannot create an instance of an abstract class /
      //    Too many arguments for 'constructor(): Number'）。
      //   这里存的只是"纪元秒"和"计数"，Int 完全够（秒到 2038 年），
      //   统一口径后整条链没有 Long，也就没有转换。
      let last: Int = p!.getInt('bind_at', 0);
      let n: Int = p!.getInt('bind_n', 0);
      if (t - last > A11Y_BIND_WINDOW_SEC) n = 0;
      n = n + 1;
      p!.edit().putInt('bind_at', t).putInt('bind_n', n).apply();
      return n;
    }
  } catch (e) {
    // 落不了盘就退化为进程内计数（进程被杀会归零，但至少同一次运行内有效）
  }
  if (t - a11yBindAt > A11Y_BIND_WINDOW_SEC) { a11yBindAt = t; a11yBindN = 0; }
  a11yBindN = a11yBindN + 1;
  return a11yBindN;
}

/** 记一次"服务正常跑满了一段"（用于把计数清零，避免一次正常的长期运行被误判） */
function clearBind(): void {
  try {
    let p = a11ySp();
    // 同上：整条链统一 Int 口径，别用 putLong
    if (p != null) p!.edit().putInt('bind_n', 0).putInt('bind_at', 0).apply();
  } catch (e) {}
  a11yBindN = 0;
  a11yBindAt = 0;
}

/* ==================== 前台服务本体 ==================== */

@UTSAndroid.Suppress("DEPRECATION")
class PWFocusService extends Service {

  // ---- 看门狗状态（强制模式；默认关） ----
  watchOn = false;
  private watchUntilSec: Int = 0;  // 0 = 不限时；否则到点自动收手（纪元秒）
  // ⚠️ 下面这几个不写 private：watchDiag() 是**顶层函数**，而 Kotlin 的 private 是
  //    类私有 —— 顶层函数访问 s.allowCsv 会直接编不过（cannot access ... it is private）。
  //    同文件里 isAllowed / loopStopped 不写 private 也是同一个道理。
  allowCsv = '';                   // 白名单包名，英文逗号分隔
  private escTicks: Int = 0;       // 连续跑偏的 tick 数
  blindTicks: Int = 0;             // 连续"查不出前台是谁"的 tick 数（探测失灵 ≠ 合规）
  inEpisode = false;               // 当前处在一次"逃逸"里（防止同一次离开被重复计数）
  pullTries: Int = 0;              // 本次逃逸已经尝试拉回几次（第 2 次起升级为遮罩）
  private lastPullSec: Int = 0;
  private stopped = false;
  private loop: WatchLoop | null = null;

  constructor() {
    super();
  }

  override onCreate(): void {
    super.onCreate();
    // 护卫要靠这个引用跑"同一套"判定；服务销毁时清掉（否则拿着死对象做判定）
    svcRef = this;
  }

  override onBind(_intent?: Intent): IBinder | null {
    return null;
  }

  override onStartCommand(intent: Intent, flags: Int, startId: Int): Int {
    // ① 文案：只有带了 title 的 Intent 才更新 —— setWatch 只送配置，不能把倒计时冲成默认文案
    if (intent.hasExtra('title')) {
      let t = intent.getStringExtra('title');
      let x = intent.getStringExtra('text');
      if (t != null) lastTitle = t;
      if (x != null) lastText = x;
    }
    let notification = buildNotification(this, lastTitle, lastText);
    // Android 14+ 起 startForeground 可以带类型参数。
    // ⚠️ 插件清单里**没有**声明 android:foregroundServiceType —— HBuilderX 内置的那套
    // aapt2/android.jar 只到 API 30 级，既不认 <property> 也不认 specialUse 这个值，
    // 写了就编不过（详见 AndroidManifest.xml 里的注释）。
    // 好在"必须声明类型"只对 targetSdk >= 34 生效，本项目 targetSdk = 28，传位是安全的。
    // 仍然 try 一层：万一哪天 targetSdk 抬上去、系统抛了
    // MissingForegroundServiceTypeException（它是 SecurityException 的子类），
    // 还能退回两参版本把前台服务撑起来 —— 起不来 = 整个强制模式失效。
    try {
      if (Build.VERSION.SDK_INT >= 34) {
        this.startForeground(NOTIFY_ID, notification, FGS_TYPE_SPECIAL_USE);
      } else {
        this.startForeground(NOTIFY_ID, notification);
      }
    } catch (e) {
      try {
        this.startForeground(NOTIFY_ID, notification);
      } catch (e2) {
        console.error('pwstudy-focus: startForeground 兜底也失败');
      }
    }
    // ② 看门狗配置：watch / allow / untilSec 三个 extra 一起来
    if (intent.hasExtra('watch')) {
      let on = intent.getIntExtra('watch', 0) == 1;
      let allow = intent.getStringExtra('allow');
      let untilSec = intent.getIntExtra('untilSec', 0);
      this.setWatch(on, allow == null ? '' : allow!, untilSec);
    }
    return super.onStartCommand(intent, flags, startId);
  }

  @UTSAndroid.Suppress("DEPRECATION")
  override onDestroy(): void {
    super.onDestroy();
    this.setWatch(false, '', 0);
    this.stopLoop();
    postOverlay(false);
    cancelPullNotify(UTSAndroid.getAppContext());
    this.stopForeground(true);
    if (svcRef === this) svcRef = null;
  }

  /**
   * 用户从"最近任务"里把 PWstudy 划掉了。
   *
   * ⚠️ 这里**第一件事必须是撤遮罩**，没有之一：
   *    遮罩是盖在**别的 App**上面的全屏窗口，它的宿主窗口管理者是**系统**而不是
   *    我们的 Activity。用户划掉卡片只杀掉了任务，那个窗口还挂在屏幕上 ——
   *    于是用户切到微信，发现自己被一层黑布锁着，而这个 App 他已经"关掉"了。
   *    这是"划一下就再也点不动"的真凶，比拉不回来严重得多。
   *
   * 复活服务这件事这里不做：MIUI / ColorOS 划卡片走的是 force-stop，
   * 任何自启动都会被 ROM 拦（见 BlackHat Asia-24 对 removeTask 的分析），
   * 硬救只会换来一轮"进程反复重启 → 保险丝跳闸"。如实让 JS 侧提示用户即可。
   */
  override onTaskRemoved(rootIntent: Intent): void {
    try {
      postOverlay(false);
      cancelPullNotify(UTSAndroid.getAppContext());
      this.stopLoop();
    } catch (e) {}
    try { super.onTaskRemoved(rootIntent) } catch (e) {}
  }

  /** 看门狗线程查询用：是否还该继续跑 */
  loopStopped(): boolean {
    return this.stopped || !this.watchOn;
  }

  /** 由 JS 侧（fgsvc.setWatch）经 Intent 下发的配置 */
  setWatch(on: boolean, allowCsv: string, untilSec: Int): void {
    this.watchOn = on;
    let allow = allowCsv == null ? '' : allowCsv!;
    // ★ 桌面**不许**进白名单（2026-10-24 改）：
    //   以前这里用 homePackage() 把系统默认 Home 并进 allow，理由是"遮罩盖住桌面
    //   会把人锁死"。代价是：按 HOME 回桌面 = 合规 = 强制模式**永远不动手** ——
    //   而"退出到桌面"恰恰是强制模式最该拦的那一下（番茄ToDo 就是这么做的：
    //   回桌面立刻弹全屏拦截页，3 秒倒数自动回计时页）。
    //   锁死的风险改由四道闸兜（拦截页可退 / 遮罩可点 / 拉回次数上限 / 逃逸 3 次作废），
    //   详见 utils/apptime.js 的 NEUTRAL 注释。系统 Home 是哪个包只留给诊断看
    //   （watchDiag 的 home=），不再拿来放行。
    if (on) {
      // 输入法也是"窗口"，但它是打字必需的中性界面；无障碍窗口事件比 UsageStats
      // 多看到这一类，认成跑偏就会在用户每次输入时把人拽回来。名单多加一道。
      let imes = imePackages(UTSAndroid.getAppContext());
      for (let i = 0; i < imes.length; i++) {
        let p = imes[i];
        if (p.length > 0 && allow.indexOf(p) < 0) {
          allow = allow.length > 0 ? allow + ',' + p : p;
        }
      }
      // 中性界面（设置 / 授权页 / 来电 / 系统界面）：盖上去就是死锁，见 NEUTRAL_CSV 的注释
      let neutrals = NEUTRAL_CSV.split(',');
      for (let i = 0; i < neutrals.length; i++) {
        let p = neutrals[i];
        if (p.length > 0 && allow.indexOf(p) < 0) {
          allow = allow.length > 0 ? allow + ',' + p : p;
        }
      }
    }
    this.allowCsv = allow;
    this.escTicks = 0;
    this.blindTicks = 0;
    this.inEpisode = false;
    this.pullTries = 0;
    this.lastPullSec = nowSec();
    if (untilSec > 0) {
      let sec = untilSec > WATCH_MAX_SEC ? WATCH_MAX_SEC : untilSec;
      this.watchUntilSec = nowSec() + sec;
    } else {
      this.watchUntilSec = 0;
    }
    if (this.watchOn && this.allowCsv.length > 0) {
      this.startLoop();
    } else {
      this.stopLoop();
      postOverlay(false);
      cancelPullNotify(UTSAndroid.getAppContext());
    }
  }

  private startLoop(): void {
    this.stopLoop();
    this.stopped = false;
    let t = new WatchLoop(this);
    this.loop = t;
    try { t.start(); } catch (e) { this.loop = null; }
  }

  private stopLoop(): void {
    this.stopped = true;
    let t = this.loop;
    this.loop = null;
    if (t != null) {
      try { t.interrupt(); } catch (e) {}
    }
  }

  /**
   * 白名单判定：自己在名单里就算合规（JS 侧把本 App / 系统中性包 / 学习 App 一起发过来）。
   * 公开（不是 private）是因为无障碍护卫也要用同一份判定 —— 两个服务各判一套必然分叉。
   */
  isAllowed(pkg: string): boolean {
    if (pkg.length == 0) return true;
    let list = this.allowCsv.split(',');
    for (let i = 0; i < list.length; i++) {
      if (list[i] == pkg) return true;
    }
    return false;
  }

  /**
   * 一次心跳。返回 true = 现在处在"跑偏中"（线程据此切到高频重试）。
   *
   * 判定链：看门狗是否该停 → 判断能力还在不在 → 现在前台是谁 → 交 seen() 决策。
   */
  tick(): boolean {
    if (!this.watchOn) return false;
    let ctx = UTSAndroid.getAppContext();
    if (ctx == null) return false;

    // 到点 / 被暂停：收手，别在专注结束后还到处拉人
    if (this.watchUntilSec > 0 && nowSec() > this.watchUntilSec) {
      this.watchOn = false;
      this.stopLoop();
      postOverlay(false);
      cancelPullNotify(ctx!);
      return false;
    }
    // 两种"能判断前台是谁"的路子，有任意一条就不收手：
    //   ① 无障碍护卫在线 —— 包名由系统事件推过来，更准更快，**不需要「使用情况访问」**
    //   ② 没开无障碍 —— 那就得靠 UsageStats，没授这个权限就判断不了
    // 两条都没有 → 宁可收手也不闭着眼睛拉人（页面上有引导）。
    if (!guardUsable() && !usageGranted(ctx!)) {
      postOverlay(false);
      return false;
    }

    let fg = queryForeground(ctx!);
    if (fg.length == 0) {
      // 查不到 ≠ 合规。
      // 早期版本这里直接 `return false`（等于"这次算没事"），后果是：只要探测那一路
      // 短暂失灵（锁屏、正在切桌面、权限刚被 ROM 收回），看门狗就把人放着不管，
      // 而且 inEpisode 也不复位 —— 用户看到的正是"完全没拦"。
      // 现在的处理：记一次"失明"，失明期间**维持**已有的逃逸状态（人还在别的 App 里，
      // 只是我们暂时看不清），连续失明到上限才撤遮罩收手（别把人锁在看不清的屏幕上）。
      this.blindTicks = this.blindTicks + 1;
      if (this.blindTicks >= BLIND_MAX_TICKS) {
        postOverlay(false);
        return false;
      }
      return this.inEpisode;
    }
    this.blindTicks = 0;
    return this.seen(fg, false);
  }

  /**
   * "前台是 pkg，该怎么办"—— tick 与无障碍事件共用的**唯一**一处策略。
   *
   * 为什么必须共用：两条输入源（定时轮询 / 窗口事件）如果各写一套判定，
   * 迟早会出现"事件那边判跑偏、轮询这边说没事"，用户看到的就是忽拉忽不拉。
   *
   * @param fromEvent true = 来自无障碍窗口事件。事件本身就是"用户真的切走了"，
   *                  不需要再攒两个 tick 去抖（那个 2 次的去抖是给轮询抗抖动的）。
   * @returns true = 当前处在跑偏中（线程据此切高频）
   */
  seen(pkg: string, fromEvent: boolean): boolean {
    if (!this.watchOn) return false;
    if (pkg.length == 0) return false;

    if (this.isAllowed(pkg)) {
      // 回到合规状态：这一次逃逸结束，撤遮罩撤通知，下次离开重新计数
      this.escTicks = 0;
      this.pullTries = 0;
      if (this.inEpisode) {
        this.inEpisode = false;
        postOverlay(false);
        cancelPullNotify(UTSAndroid.getAppContext());
      }
      return false;
    }

    if (!fromEvent) {
      this.escTicks = this.escTicks + 1;
      if (this.escTicks < ESC_TICKS) return true;   // 刚划走不到一个来回：先看看，不算账
    }

    if (!this.inEpisode) {
      this.inEpisode = true;
      watchEscapeCount = watchEscapeCount + 1;
      postPullNotify();
    }

    let now = nowSec();
    if (now - this.lastPullSec < PULL_GAP_SEC) return true;
    this.lastPullSec = now;
    this.pullTries = this.pullTries + 1;
    watchPullCount = watchPullCount + 1;

    let ok = pullSelf(this.pullTries);
    // 升级成遮罩 —— 那层盖在别的 App 上面，用户点不动，也就绕不过去。
    //
    // ⚠️ 判据不是"pullSelf 返回了什么"（moveTaskToFront 返回 void，拿不到成败，
    //    那条路永远只能报"没抛异常"），而是**再看一眼前台**：还是别人就说明没拉回来。
    //    早期版本写的是 `pullTries >= 2`，等于白等一个来回（约 2 秒）才上遮罩，
    //    用户那 2 秒里是彻底自由的 —— 这正是"切走以后什么都没发生"的观感来源之一。
    //
    // ★ 但刚拉过拦截页的那一下要留一段静默期（INTERCEPT_GRACE_SEC）：
    //   拦截页是 startActivity 出去的，此刻前台**还没**切过去，needOverlay() 必然为真。
    //   立刻盖遮罩的话，遮罩会压在拦截页上面，用户得自己点一下才回去 ——
    //   等于把"3 秒倒数自动回"废掉，观感还更差（黑屏闪一下再换一张黑屏）。
    //   静默期内不盖；拦截页真被 ROM 拦掉的话，静默期一过下一拍照样盖。
    let inGrace = now < interceptGraceUntilSec;
    if (!ok || (this.needOverlay() && !inGrace)) postOverlay(true);
    // 安全阀：连续拉了很多次还回不来（多半是遇到了我们没认出来的桌面/输入法，
    // 或某个 ROM 把前台事件吞了），先把遮罩撤掉，免得把人锁在屏幕外面。
    // 拉回动作本身照旧继续（下面还在跑），下一轮逃逸会重新盖上。
    if (this.pullTries >= OVERLAY_MAX_TRIES) postOverlay(false);
    return true;
  }

  /**
   * 现在该不该盖遮罩：前台**确实还是别人**才盖。
   *
   * 为什么不无条件盖：拉回其实已经成功、而我们下一跳还没看到新前台的那一瞬间，
   * 遮罩会盖在自己 App 上再被撤掉 —— 用户看到的就是自己的界面闪一下黑，很掉价。
   *
   * ⚠️ 失明（查不出前台是谁）时必须**延续**已有状态，不能一律不盖：
   *    这与 tick() 里"查不到 ≠ 合规"是同一个口径。原来这里返回 false，
   *    于是人已经切走、探测那一路正好瞎了一下 → 不拉也不盖 →
   *    用户看到的就是"强制模式完全没反应"（2026-10-14 修复）。
   */
  needOverlay(): boolean {
    let ctx = UTSAndroid.getAppContext();
    if (ctx == null) return false;
    let fg = queryForeground(ctx!);
    if (fg.length == 0) return this.inEpisode;
    return !this.isAllowed(fg);
  }
}

/* ==================== 看门狗线程 ====================
 * 为什么不用 setInterval：WebView / JS 定时器在后台会被系统挂起（这正是"强制拉回失效"的
 * 头号原因）；而 .uts 里跑的是真 JVM 线程，前台服务活着它就活着，退到后台照样每秒盯。
 */
class WatchLoop extends Thread {
  private owner: PWFocusService;

  constructor(owner: PWFocusService) {
    super();
    this.owner = owner;
  }

  override run(): void {
    while (!this.owner.loopStopped()) {
      let hot = false;
      try {
        hot = this.owner.tick();
      } catch (e) {
        hot = false;
      }
      // 300 = 已经判定跑偏，高频重试（人一回来就能立刻撤遮罩）；
      // 600 = 一切正常，低频看一眼就够。字面量是故意的：Thread.sleep 收 Long，
      // 而 UTS 的 Int 常量不会自动放宽成 Long。
      // ★ 2026-10-24：正常态 1500 → 600。用户实测"按 HOME 回桌面，桌面先静止在那儿
      //   一秒多，拦截页才弹"。机身自己在正常态只是 0.6 秒查一次前台，代价很小
      //   （一次 UsageStats 查询，专注期间才跑，最长也就一轮专注那么久），
      //   换来的是"一按 HOME 几乎立刻被盖住"——这才是强制模式该有的手感。
      // 切成 100ms 小段睡：无障碍事件一报"用户切走了"就置 kickWanted，
      // 这样最迟 100ms 内就会重判一次（否则最坏要等满一轮）。
      // 小段的代价只是一次标志位判断，不建对象、不抢锁。
      //
      // ⚠️ 这里是"睡几轮"而不是"睡多少毫秒"：Thread.sleep 收 Long，
      // 而 UTS 的 Int 变量**不会**自动放宽成 Long（Kotlin 里 Int→Long 也不隐式转换），
      // 把算出来的毫秒数传进去会编译失败。字面量 100 才是安全的。
      let rounds = hot ? 3 : 6;
      for (let i = 0; i < rounds; i++) {
        if (kickWanted) {
          kickWanted = false;
          break;
        }
        if (this.owner.loopStopped()) break;
        try {
          Thread.sleep(100);
        } catch (e) {
          return;    // 被 interrupt：收摊
        }
      }
    }
  }
}

/* ==================== 主线程任务（挂/撤遮罩必须在主线程） ==================== */

class OverlaySyncTask implements Runnable {
  override run(): void {
    applyOverlay(UTSAndroid.getAppContext());
  }
}

class PullNowTask implements Runnable {
  override run(): void {
    pullSelf(1);
  }
}

function uiPost(task: Runnable) {
  try {
    if (mainHandler == null) mainHandler = new Handler(Looper.getMainLooper());
    mainHandler!.post(task);
  } catch (e) {}
}

/* ==================== 悬浮窗遮罩 ====================
 * 安卓 10 起"后台启动 Activity"被系统限制，moveTaskToFront / startActivity 都可能被
 * 悄悄拦掉。悬浮窗（TYPE_APPLICATION_OVERLAY）不吃这套限制：它直接盖在那个 App 上面，
 * 用户点不到下面的内容 —— 这是唯一"绕不过去"的一层，代价是需要用户授权
 * 「显示在其他应用上层」（SYSTEM_ALERT_WINDOW）。
 *
 * 安全阀：遮罩只在"前台确实是那个非白名单 App"时挂着。用户被拉回 PWstudy
 * 或被系统界面接管（设置 / 来电 / 最近任务）时，下一次心跳（热态 300ms）就把遮罩撤掉，
 * 不会把手机锁死。
 * ⚠️ 桌面**不在这张保险网里**（2026-10-24）：回桌面是强制模式最该拦的一下，
 *    放行它等于强制模式永远不响。锁死风险改由四道闸兜（见 utils/apptime.js 的 NEUTRAL 注释）。
 */
class PullOverlay extends TextView {
  constructor(ctx: Context) {
    super(ctx);
  }

  override onTouchEvent(event: MotionEvent): boolean {
    // 点哪儿都是"我要回去"：再拽一次（失败了遮罩继续挂着，用户也去不了别的 App）
    uiPost(new PullNowTask());
    return true;
  }
}

function applyOverlay(ctx: Context | null) {
  if (ctx == null) return;
  if (overlayWanted && overlayView == null) {
    if (!canDrawOverlays(ctx!)) { overlayWanted = false; return; }
    try {
      let wm = ctx!.getSystemService(Context.WINDOW_SERVICE) as WindowManager
      let v = new PullOverlay(ctx!)
      v.setText('强制模式 · 这段专注还没跑完\n\n点一下回到 PWstudy')
      v.setTextSize(22.0.toFloat())
      v.setTextColor(Color.WHITE)
      v.setBackgroundColor(Color.argb(236, 23, 32, 26))
      v.setGravity(Gravity.CENTER)
      v.setPadding(60, 60, 60, 60)
      let lp = new WindowManager.LayoutParams(
        ViewGroup.LayoutParams.MATCH_PARENT,
        ViewGroup.LayoutParams.MATCH_PARENT
      )
      lp.type = Build.VERSION.SDK_INT >= 26 ? WINDOW_TYPE_OVERLAY : WINDOW_TYPE_PHONE
      lp.format = PixelFormat.TRANSLUCENT
      lp.gravity = Gravity.CENTER
      lp.flags = WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN | WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
      wm.addView(v, lp)
      overlayView = v
    } catch (e) {
      overlayView = null;
      overlayWanted = false;
    }
  } else if (!overlayWanted && overlayView != null) {
    try {
      let wm = ctx!.getSystemService(Context.WINDOW_SERVICE) as WindowManager
      wm.removeView(overlayView!)
    } catch (e) {}
    overlayView = null;
  }
}

function postOverlay(want: boolean) {
  if (overlayWanted == want) return;
  overlayWanted = want;
  uiPost(new OverlaySyncTask());
}

/* ==================== 悬浮灵动岛胶囊（专注时后台倒计时） ====================
 *
 * 仿番茄时钟那种「左上角/顶部悬浮倒计时胶囊」：专注进行中、App 退到后台时，在别的 App 上方
 * 顶部居中悬浮一个圆角小胶囊，显示剩余时间；点一下把 PWstudy 拉回前台（复用
 * PullNowTask 那条现成的拉回链路）。
 *
 * 与强制模式遮罩的区别：
 *   · 遮罩是**全屏、阻塞、盖住那个 App** 的保活手段（强制模式专用）；
 *   · 胶囊是**小、非阻塞、只显示倒计时**的便利显示 —— 用户一眼看到还在计时，点一下回来。
 *   · 用的还是同一套 SYSTEM_ALERT_WINDOW（canDrawOverlays 检查 + TYPE_APPLICATION_OVERLAY），
 *     只是权限**独立授权**：没开强制模式也能单独开胶囊。
 *
 * 非阻塞关键：FLAG_NOT_FOCUSABLE（不抢焦点）+ FLAG_NOT_TOUCH_MODAL（窗口外点击透传），
 * 这样它浮在别家 App 上不会吞掉人家的操作，只截获自己这一小块上的点击（用来拉回）。
 * 挂/撤必须在主线程（同遮罩，见 uiPost）。
 */
let capsuleView: TextView | null = null;
let capsuleWanted = false;
let capsuleText = '';
let capsuleEndAt = 0;   // 倒计时终点（ms）；0 = 不自转（暂停 / 正计时由 JS 静态显示）
let capsuleLabel = '';  // 阶段前缀（"专注中 " / "休息中 "），原生每秒拼上剩余时间

class CapsuleView extends TextView {
  constructor(ctx: Context) {
    super(ctx);
  }

  override onTouchEvent(event: MotionEvent): boolean {
    // 点一下 = 回到 PWstudy（复用强制模式那条现成的拉回链路）
    uiPost(new PullNowTask());
    return true;
  }
}

// 原生每秒自转一次：App 在后台时 WebView 的 JS 计时器被系统挂起，胶囊倒计时会冻住；
// 但进程因为有前台服务还活着，主线程 Handler 能继续跑 —— 所以倒计时交给原生自己数。
class CapsuleTickTask implements Runnable {
  override run(): void {
    if (!capsuleWanted || capsuleView == null) return;
    if (capsuleEndAt > 0) {
      let remain = Math.floor((capsuleEndAt - System.currentTimeMillis()) / 1000);
      if (remain < 0) remain = 0;
      try { capsuleView!.setText(capsuleLabel + capsuleMmss(remain)); } catch (e) {}
    }
    if (capsuleWanted) mainHandler!.postDelayed(new CapsuleTickTask(), 1000);
  }
}

class CapsuleApplyTask implements Runnable {
  override run(): void {
    applyCapsule(UTSAndroid.getAppContext());
  }
}

function capsuleMmss(sec: number): string {
  let s = Math.floor(sec);
  if (s < 0) s = 0;
  let m: Int = (s / 60).toInt();
  let r: Int = (s % 60).toInt();
  let rs = r < 10 ? '0' + r.toString() : r.toString();
  return m.toString() + ':' + rs;
}

function applyCapsule(ctx: Context | null) {
  if (ctx == null) return;
  if (capsuleWanted && capsuleView == null) {
    if (!canDrawOverlays(ctx!)) { capsuleWanted = false; return; }
    try {
      let wm = ctx!.getSystemService(Context.WINDOW_SERVICE) as WindowManager
      let v = new CapsuleView(ctx!)
      v.setText(capsuleText)
      v.setTextSize(15.0.toFloat())
      v.setTextColor(Color.WHITE)
      let bg = new GradientDrawable()
      bg.setColor(Color.argb(232, 23, 25, 38))
      bg.setCornerRadius(999.0.toFloat())
      v.setBackground(bg)
      v.setGravity(Gravity.CENTER)
      v.setPadding(34, 12, 34, 12)
      let lp = new WindowManager.LayoutParams(
        ViewGroup.LayoutParams.WRAP_CONTENT,
        ViewGroup.LayoutParams.WRAP_CONTENT
      )
      lp.type = Build.VERSION.SDK_INT >= 26 ? WINDOW_TYPE_OVERLAY : WINDOW_TYPE_PHONE
      lp.format = PixelFormat.TRANSLUCENT
      lp.gravity = Gravity.TOP | Gravity.CENTER_HORIZONTAL
      // 顶栏下方一点（40dp），避开状态栏
      let dm = ctx!.getResources().getDisplayMetrics()
      lp.y = ((40 * dm.density) as Number).toInt()
      // 非阻塞：不抢焦点（NOT_FOCUSABLE）+ 窗口外点击透传（NOT_TOUCH_MODAL）
      lp.flags = WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE | WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL
      wm.addView(v, lp)
      capsuleView = v
      // 启动原生自转：App 后台时 WebView 不跑 tick，倒计时由这里数（endAt=0 时也不更新，只等停止）
      mainHandler!.postDelayed(new CapsuleTickTask(), 1000)
    } catch (e) {
      capsuleView = null
      capsuleWanted = false
    }
  } else if (!capsuleWanted && capsuleView != null) {
    try {
      let wm = ctx!.getSystemService(Context.WINDOW_SERVICE) as WindowManager
      wm.removeView(capsuleView!)
    } catch (e) {}
    capsuleView = null
  } else if (capsuleWanted && capsuleView != null) {
    // 只刷新文案（胶囊常驻，倒计时每秒变）
    try { capsuleView!.setText(capsuleText) } catch (e) {}
  }
}

function postCapsule(want: boolean, text: string, endAt: number, label: string) {
  capsuleText = text
  capsuleEndAt = endAt
  capsuleLabel = label
  capsuleWanted = want
  uiPost(new CapsuleApplyTask())
}

/** 显示 / 刷新悬浮胶囊（text = 即时文案兜底，endAt = 倒计时终点 ms，label = 阶段前缀供原生自转拼接） */
export function showCapsule(text: string, endAt: number, label: string): boolean {
  postCapsule(true, text, endAt, label)
  return true
}

/** 只刷新胶囊文案与终点（已显示时更新倒计时，没显示时也排上） */
export function updateCapsule(text: string, endAt: number, label: string): boolean {
  postCapsule(true, text, endAt, label)
  return true
}

/** 撤掉胶囊 */
export function hideCapsule(): boolean {
  postCapsule(false, '', 0, '')
  return true
}

/* ==================== 拦截页（2026-10-15，参照番茄ToDo 严格模式实测录像） ====================
 * 竞品实测（用户录屏）：按 HOME/切走 → 弹出一个**自己的全屏黑页**（"您已禁止访问桌面和
 * 多任务，3 秒后跳转至计时"），倒计时结束自动跳回计时页。整个流程用户几乎看不到桌面。
 *
 * 为什么它弹得出来、我们此前弹不出来：拦截页是 startActivity。安卓 10+ 后台启动被
 * AMS 静默拦，唯一的官方豁免是 **SYSTEM_ALERT_WINDOW 已授权**（悬浮窗权限）——
 * 没授它，三条拉回路（guard 服务内 / moveTaskToFront / launch intent）在安卓 10+
 * 上全是静默失败，这正是"强制模式毫无反应"的根因。授权之后拦截页就是四条路里
 * 体验最好的一条：全屏、独立任务栈、倒计时自动跳回，不依赖用户点任何东西。
 * MIUI 的「后台弹出界面」是另一道独立闸（开了悬浮窗也要开它），见 utils/setup.js 的引导。
 *
 * 设计要点（照抄竞品验证过的行为）：
 *   · 黑底全屏 + 大字，除了倒计时什么都不放 —— 它的任务只有一个：把屏幕占住
 *   · 3 秒倒计时自动跳回计时页（launch intent），用户点一下立即跳 —— 比遮罩"点了
 *     再拉一次（可能被拦）"的确定性高得多：这时 Activity 在前台，启动自己 App
 *     完全合法，不存在被拦的可能
 *   · excludeFromRecents + noHistory：最近任务里不留痕，按 HOME 即销毁，下次逃逸
 *     重新弹 —— 不留一个"能绕过的后门"页面
 */
class PWPullActivity extends Activity {
  private ui: TextView | null = null;
  private left: Int = PULL_INTERCEPT_SEC;
  private h: Handler | null = null;

  // ⚠️ 同 PFGuardService：extends 生成 `: Activity` 不带括号，缺显式构造
  //    = kotlin 报 "must be initialized here"（check-uts 守着）
  constructor() {
    super();
  }

  override onCreate(savedInstanceState: Bundle | null): void {
    super.onCreate(savedInstanceState);
    let v = new TextView(this);
    v.setText(this.text());
    v.setTextSize(22.0.toFloat());
    v.setTextColor(Color.WHITE);
    v.setBackgroundColor(Color.argb(255, 23, 32, 26));
    v.setGravity(Gravity.CENTER);
    v.setPadding(60, 60, 60, 60);
    setContentView(v);
    this.ui = v;
    this.left = PULL_INTERCEPT_SEC;
    let h = new Handler(Looper.getMainLooper());
    this.h = h;
    this.schedule(h!);
  }

  private text(): string {
    return '强制模式 · 这段专注还没结束\n\n' + this.left + ' 秒后自动回到计时\n点一下立即回';
  }

  private schedule(h: Handler): void {
    h.postDelayed(new InterceptTick(this), 1000);
  }

  // 每秒一跳：先改本地剩余秒数，到 0 跳回；否则刷新文案再排下一秒
  onTick(): void {
    this.left = this.left - 1;
    if (this.left <= 0) {
      this.goBack();
      return;
    }
    let u = this.ui;
    if (u != null) {
      try { u.setText(this.text()) } catch (e) {}
    }
    let h = this.h;
    if (h != null) this.schedule(h!);
  }

  /** 用户点屏幕任意处 = 跳过倒计时立即回 */
  override onTouchEvent(event: MotionEvent): boolean {
    this.goBack();
    return true;
  }

  /**
   * 跳回计时页并销毁自己。
   *
   * ⚠️ 不能只发「启动页 intent」—— 那会把人送回 App 首页（主页），
   *    而不是刚才在跑的专注页。用户原话要的是「应用自己打开**专注**页面」。
   *    所以这里用 moveTaskToFront 把 PWstudy 自己的 task 提回最前：
   *    专注页本来就在那个 task 的栈顶（按 HOME 只是把它压到后台），
   *    提回来再 finish 掉自己，露出来的就是**专注页 + 原样计时状态**，不重建。
   */
  goBack(): void {
    try {
      let am = this.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
      let tasks = am.getRunningTasks(20)
      if (tasks != null) {
        for (let t of tasks!) {
          if (t == null) continue
          let cn = t.topActivity != null ? t.topActivity : t.baseActivity
          if (cn != null && cn!.getPackageName() == this.getPackageName()) {
            am.moveTaskToFront(t.id, 0)
            break
          }
        }
      }
    } catch (e) {}
    try { this.finish() } catch (e) {}
  }

  override onDestroy(): void {
    // 别把 Handler 的回调留到销毁之后（泄漏 + 对着死 Activity setText）
    let h = this.h;
    if (h != null) { try { h.removeCallbacksAndMessages(null) } catch (e) {} }
    this.h = null;
    this.ui = null;
    super.onDestroy();
  }
}

/** 倒计时的每一秒。UTS 的内部类要显式持有 owner（同 WatchLoop / A11yQueryThread）。 */
class InterceptTick extends Runnable {
  private owner: PWPullActivity;

  constructor(o: PWPullActivity) {
    super();
    this.owner = o;
  }

  override run(): void {
    this.owner.onTick();
  }
}

/* ==================== 通知 ==================== */

/** 建通知渠道（Android 8+；渠道已存在时重复创建无害） */
function ensureChannel(ctx: Context) {
  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
    let manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    let channel = new NotificationChannel(
      CHANNEL_ID,
      '专注进行中',
      NotificationManager.IMPORTANCE_LOW        // 低打扰：常驻倒计时不该出声
    )
    channel.setDescription('专注计时进行中')
    manager.createNotificationChannel(channel)
  }
}

function buildNotification(ctx: Context, title: string, text: string): Notification {
  ensureChannel(ctx)
  let builder = new NotificationCompat.Builder(ctx, CHANNEL_ID)
  builder.setContentTitle(title)
  builder.setContentText(text)
  builder.setSmallIcon(ctx.getApplicationInfo().icon)
  builder.setWhen(System.currentTimeMillis())
  builder.setOnlyAlertOnce(true)     // 刷新文案时不重复响铃
  builder.setOngoing(true)           // 正在进行中：不可滑动清除
  builder.setAutoCancel(false)
  // 点击通知回到本 App
  let launch = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
  if (launch != null) {
    launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP)
    let pi = PendingIntent.getActivity(ctx, 0, launch, PI_FLAGS)
    builder.setContentIntent(pi)
  }
  return builder.build();
}

/** 拉回专用渠道：必须高重要级，fullScreenIntent 才会被系统当真 */
function ensurePullChannel(ctx: Context) {
  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
    try {
      let manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
      let channel = new NotificationChannel(
        CHANNEL_PULL,
        '强制拉回',
        NotificationManager.IMPORTANCE_HIGH
      )
      channel.setDescription('离开学习 App 时把你拉回 PWstudy')
      // 高重要级默认带提示音；这里想静音就静音，静不了也不影响拉回
      try { channel.setSound(null, null) } catch (e) {}
      try { channel.enableVibration(true) } catch (e) {}
      manager.createNotificationChannel(channel)
    } catch (e) {}
  }
}

/**
 * 拉回通知：挂 fullScreenIntent。
 * 安卓 10+ 允许应用在通知里带"全屏意图"，系统会直接把这个 Activity 弹到最前
 *（需要 USE_FULL_SCREEN_INTENT；14 起未获授权会降级成横幅提示，不报错也不闪退）。
 * 每次"逃逸"只发一条，回到学习 App 就撤掉。
 */
function buildPullNotification(ctx: Context): Notification {
  ensurePullChannel(ctx)
  let builder = new NotificationCompat.Builder(ctx, CHANNEL_PULL)
  builder.setContentTitle('强制模式')
  builder.setContentText('先把这段专注跑完 —— 点这里回到 PWstudy')
  builder.setSmallIcon(ctx.getApplicationInfo().icon)
  builder.setWhen(System.currentTimeMillis())
  builder.setPriority(1)          // NotificationCompat.PRIORITY_HIGH
  builder.setCategory('alarm')    // 闹钟类别：ROM 更愿意放行全屏意图
  builder.setOnlyAlertOnce(true)
  builder.setOngoing(false)
  builder.setAutoCancel(true)
  let launch = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
  if (launch != null) {
    launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP)
    let pi = PendingIntent.getActivity(ctx, 1, launch, PI_FLAGS)
    builder.setContentIntent(pi)
    try { builder.setFullScreenIntent(pi, true) } catch (e) {}
  }
  return builder.build();
}

/** 发拉回通知（一次逃逸只发一条，回到学习 App 就撤） */
function postPullNotify() {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return;
  try {
    let nm = ctx!.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    nm.notify(PULL_NOTIFY_ID, buildPullNotification(ctx!))
  } catch (e) {}
}

function cancelPullNotify(ctx: Context | null) {
  if (ctx == null) return;
  try {
    let manager = ctx!.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    manager.cancel(PULL_NOTIFY_ID)
  } catch (e) {}
}

/* ---------- 无障碍护卫掉线提醒 ---------- */

let guardDropAtSec: Int = 0;   // 上次发掉线提醒的时刻（节流用）

function ensureGuardChannel(ctx: Context) {
  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
    try {
      let manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
      let channel = new NotificationChannel(
        CHANNEL_GUARD,
        '专注护卫状态',
        NotificationManager.IMPORTANCE_HIGH
      )
      channel.setDescription('无障碍护卫掉线时提醒你回来重新打开')
      try { channel.setSound(null, null) } catch (e) {}
      manager.createNotificationChannel(channel)
    } catch (e) {}
  }
}

function buildGuardDropNotification(ctx: Context): Notification {
  ensureGuardChannel(ctx)
  let builder = new NotificationCompat.Builder(ctx, CHANNEL_GUARD)
  builder.setContentTitle('专注护卫掉线了')
  builder.setContentText('无障碍被系统停掉了，强制 / 严格模式看不住 —— 点这里回 PWstudy 重新打开')
  builder.setSmallIcon(ctx.getApplicationInfo().icon)
  builder.setWhen(System.currentTimeMillis())
  builder.setPriority(1)          // PRIORITY_HIGH
  builder.setCategory('alarm')
  builder.setOngoing(false)
  builder.setAutoCancel(true)
  let launch = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
  if (launch != null) {
    launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP)
    let pi = PendingIntent.getActivity(ctx, 2, launch, PI_FLAGS)
    builder.setContentIntent(pi)
  }
  return builder.build();
}

/**
 * 发"护卫掉线"提醒。GUARD_NOTIFY_GAP_SEC 内只发一次：
 * onUnbind 在重绑风暴里可能连着来好几次，提醒刷屏比掉线本身还烦。
 */
function postGuardDropNotify() {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return;
  try {
    let now = nowSec();
    if (now - guardDropAtSec < GUARD_NOTIFY_GAP_SEC) return;
    guardDropAtSec = now;
    let nm = ctx!.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    nm.notify(GUARD_NOTIFY_ID, buildGuardDropNotification(ctx!))
  } catch (e) {}
}

/* ==================== 无障碍护卫服务 ====================
 * 它解决的是"看门狗看不见"这件事上的两处硬伤：
 *
 *   ① **前台是谁**：不必再轮询 UsageStats（粒度粗、还要用户单独去授「使用情况访问」）。
 *      窗口切换事件是系统直接推过来的 —— 更快、更准，而且**不需要那个权限**。
 *   ② **拉得动吗**：安卓 10 起系统限制"后台启动 Activity"，官方豁免清单里明确列了
 *      "由系统绑定的服务（无障碍 / 通知监听 / VPN / 输入法）"这一类。
 *      也就是说，本服务一旦被系统挂上，moveTaskToFront / startActivity 的可信度就上一个台阶
 *      —— 这是悬浮窗遮罩之外唯一"提前拿到许可"的路子（遮罩是事后盖上去，观感差得多）。
 *
 * 边界（刻意不做的事）：
 *   · 不读屏幕内容（虽然清单里申请了 canRetrieveWindowContent，但只用来分辨"这是应用窗口
 *     还是输入法/通知栏窗口"，不解析控件文本、不截图、不上传任何东西）；
 *   · 不模拟点击；
 *   · **不吞按键**。理由是三条：一是 Home 键本来就拦不住（系统自己处理，任何三方应用都拿不到），
 *     吞了返回键也拦不住 Home，收益有限；二是把返回/多任务键全局吞掉，用户在正常应用里
 *     会莫名其妙按不动返回；三是来电、权限弹窗这类系统界面也可能被判成"非白名单"，
 *     吞键会挡住用户接电话。所以"拦不住你走，但一定把你拽回来"才是这个能力该有的定位。
 */
/**
 * 把所有"跟 UTS 运行时交互"的活儿收进独立函数并逐个 try：
 * 这个类的实例由**系统**创建，进程可能是裸的（UTS 运行时没初始化过），
 * 任何一处异常都会让系统判定"服务崩了" → 杀进程 → 重 bind → 再崩（见上面的保险丝注释）。
 * 所以原则只有一条：**这里不信任任何东西能成功**。
 */
class PFGuardService extends AccessibilityService {
  // 同 A11yQueryThread：extends 生成的是 `: AccessibilityService`（不带括号），
  // 靠显式构造里的 super() 把父类初始化掉，缺了就编不过。
  constructor() {
    super();
    // 记下实例：拉回要从服务内部发起才拿得到豁免（见 pullFromGuard）
    try { guardRef = this } catch (e) {}
  }

  /**
   * 用**服务自己**的 context 把 PWstudy 拉回前台。
   *
   * ⚠️⚠️ 2026-10-14 纠正掉一条**错误结论**，别再照它改回去 ⚠️⚠️
   *
   *   旧注释（以及 interface.uts / utils/fgsvc.js 里的同款说法）写的是：
   *   "安卓 10 起限制后台启动 Activity，官方豁免给'由系统绑定的服务'，无障碍服务正属此类，
   *    所以从服务内部 this.startActivity 才拉得动。" —— **这是错的**。
   *
   *   官方《Activity security》里后台启动的豁免是这几条：
   *     有可见窗口 / 是输入法 / **有 SYSTEM_ALERT_WINDOW** / 有系统特权 /
   *     **被"另一个可见应用"的服务绑定** / 系统发的 PendingIntent。
   *   无障碍服务是**我们自己这个 App** 的组件，不是"另一个可见应用" ——
   *   它内部 startActivity 与 appContext.startActivity 在 AMS 那里是**同一个 uid、
   *   同一个后台状态**，一样被静默拦掉（logcat 只有 "Background activity start ...
   *   blocked"，**不抛异常**，所以 pullSelf 永远返回 true、界面永远说已就绪）。
   *   这正是强制模式连着好几轮"开了无障碍也毫无反应"的根源。
   *
   *   那它为什么还留着？两点：① 调用链最短，不经过 PackageManager 之外的任何东西，
   *   拿到悬浮窗权限之后它同样被放行（豁免是**按 app** 判的，与用哪个 Context 无关），
   *   留着不亏；② 万一将来某个 ROM 对服务进程更宽容，它是现成的通路。
   *   **但它不是"拉回来"的保证** —— 保证来自 SYSTEM_ALERT_WINDOW。
   */
  pullFromGuard(): boolean {
    try {
      let pm = this.getPackageManager();
      if (pm == null) return false;
      let launch = pm.getLaunchIntentForPackage(this.getPackageName());
      if (launch == null) return false;
      // NEW_TASK：服务没有 task 栈，必须有；
      // REORDER_TO_FRONT + SINGLE_TOP：把已存在的那个 Activity 提到前面，
      // **不重建** —— 专注页正在跑的计时状态原样留着。
      launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP);
      this.startActivity(launch);
      return true;
    } catch (e) {
      return false;
    }
  }

  override onServiceConnected(): void {
    // super 也要包：生成的 Kotlin 里它同样可能触到未初始化的运行时
    try { super.onServiceConnected() } catch (e) {}

    // 第一件事就是过保险丝 —— 已经跳过闸的话，连状态都别碰
    let n: Int = 0;
    try { n = bumpBind() } catch (e) {}
    if (n > A11Y_BIND_MAX) {
      a11yTripped = true;
      return;
    }
    a11yTripped = false;

    // 配置主要靠清单里的 res/xml（meta-data）；这里再补一份只是兜底，
    // 失败就失败 —— 绝不能因为配不上而让服务崩（以前这里还 console.error 过，
    // 在裸进程里那条日志本身就是风险点）。
    try { this.setServiceInfo(buildGuardInfo()) } catch (e) {}

    try { guardOn = true } catch (e) {}
    try { guardPkg = '' } catch (e) {}
    try { guardConnAtSec = nowSec() } catch (e) {}
    try { guardAtSec = nowSec() } catch (e) {}
    try { kickWanted = true } catch (e) {}
  }

  override onAccessibilityEvent(event: AccessibilityEvent): void {
    try {
      if (a11yTripped) return;
      guardEvents = guardEvents + 1;
      if (event == null) return;
      // 1 = AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED：只认"某个窗口拿到焦点"
      if (event.getEventType() != 1) return;
      let p = event.getPackageName();
      if (p == null) return;
      // ⚠️ 别写 String(p!) —— 生成的 Kotlin 是 `String(p!!)`，而 Kotlin 的 String 只有
      //    StringBuffer/StringBuilder/ByteArray/CharArray 四个构造，CharSequence 不在其中
      //    （云打包：None of the following candidates is applicable）。
      //    getPackageName() 返回的是 CharSequence，转成字符串用 toString()。
      let pkg = p!.toString();
      if (pkg.length == 0) return;
      guardPkg = pkg;
      guardAtSec = nowSec();
      kickWanted = true;
      let s = svcRef;
      if (s != null && s.watchOn) {
        // 走看门狗同一个 seen()：这是"用户真的切走了"，不必再攒两个 tick 去抖
        try { s.seen(pkg, true) } catch (e) {}
      }
    } catch (e) {
      // 事件回调里出任何岔子都只丢这一次事件，绝不让异常冒到系统那边去
    }
  }

  override onInterrupt(): void {
  }

  override onUnbind(intent: Intent): boolean {
    try {
      guardOn = false;
      guardRef = null;        // 服务不在了 → 豁免通路随之失效，别再让 pullSelf 走它
      guardPkg = '';
      kickWanted = true;      // 让看门狗立刻重判一次（判定依据变了）
      // ★ 掉线喊人（2026-10-25）：强制 / 严格模式的"眼睛"没了，应用侧救不回来
      //   （无障碍开关只有用户能扳）—— 只能立刻提醒，别让人以为还看得住。
      //   条件收得很紧：看门狗（前台服务）还在跑 = 强制模式还开着，才有喊的必要；
      //   日常手动关无障碍 / 重绑间隙不算。
      let s = svcRef;
      if (s != null && s.watchOn) postGuardDropNotify();
    } catch (e) {}
    try { return super.onUnbind(intent) } catch (e) { return false }
  }

  override onDestroy(): void {
    try { super.onDestroy() } catch (e) {}
    try { guardOn = false } catch (e) {}
    try { guardRef = null } catch (e) {}
    try { guardPkg = '' } catch (e) {}
  }
}

/** 护卫的服务配置（与 res/xml 保持一致；只在 setServiceInfo 兜底时用） */
function buildGuardInfo(): AccessibilityServiceInfo {
  let info = new AccessibilityServiceInfo();
  info.eventTypes = AccessibilityEvent.TYPE_WINDOW_STATE_CHANGED;
  info.feedbackType = AccessibilityServiceInfo.FEEDBACK_GENERIC;
  // ⚠️ notificationTimeout 在 Android 里是 **long**（不是 int）。
  //    写 `= A11Y_NOTIFY_MS`（Int 常量）会报 "actual type is 'Int', but 'Long' was expected" ——
  //    Kotlin 的**字面量**能按目标类型推断成 Long，但 Int 常量不会自动放宽。
  //    所以这里直接写字面量（与 Thread.sleep 那两处同一个规矩），常量留在上面当注释。
  info.notificationTimeout = 100;
  // ⚠️ 常量名是 DEFAULT，不是 FLAG_DEFAULT（后者不存在 → Unresolved reference）。
  //    取值与 res/xml 的 android:accessibilityFlags="flagDefault" 对齐。
  info.flags = AccessibilityServiceInfo.DEFAULT;
  return info;
}

/**
 * ⚠️ 别删这个函数，它唯一的作用是把 PFGuardService 钉在编译产物里。
 *
 * UTS 编译器会剪掉"代码里没人引用"的声明。PFGuardService 是**系统**按清单创建的，
 * 源码里从来没有 new 过它 —— 于是整个类（连同只被它用到的 bumpBind / buildGuardInfo）
 * 被整块剪掉。实测：10-12 那次成功打出的 APK 里，dex 中只有 PWFocusService / WatchLoop /
 * PullOverlay / OverlaySyncTask / PullNowTask，**没有 PFGuardService**，
 * 而清单里却声明了它 —— 用户在系统设置里打开开关只会拿到 ClassNotFoundException。
 *
 * 剪枝的判据是"有没有被可达代码引用"，所以这里 new 一次把它钉住。
 * 实例不会被 bind、不产生任何副作用，只为一个编译期引用。
 */
export function keepGuardClass(): boolean {
  try {
    let probe = new PFGuardService();
    return probe != null;
  } catch (e) {
    return false;
  }
}

/* ==================== 探测：现在前台是谁 / 有没有权限 ==================== */

/** 「使用情况访问」是否还开着。查不出来就当开着（查不出来时 queryEvents 也是空的，不会误判） */
function usageGranted(ctx: Context): boolean {
  try {
    let appOps = ctx.getSystemService(Context.APP_OPS_SERVICE) as AppOpsManager
    let mode = appOps.checkOpNoThrow(
      AppOpsManager.OPSTR_GET_USAGE_STATS,
      Process.myUid(),
      ctx.getPackageName()
    )
    return mode == AppOpsManager.MODE_ALLOWED
  } catch (e) {
    return true
  }
}

/** 有没有"盖在别的 App 上面"的权限（授权页在 utils/apptime.js 里跳） */
function canDrawOverlays(ctx: Context): boolean {
  try {
    if (Build.VERSION.SDK_INT < 23) return true          // 6.0 之前装机即有此权限
    return Settings.canDrawOverlays(ctx)
  } catch (e) {
    return false
  }
}

/**
 * 系统默认桌面（Home）的包名；查不到返回空串。
 *
 * 为什么值得单独问一次：遮罩是盖全屏的，桌面要是被判成"跑偏"，用户按 Home 之后
 * 连桌面都点不动（只剩重启）。JS 侧名单里列了主流 ROM 的桌面包，这里再加一道
 * 与 ROM 无关的兜底 —— 直接问系统"谁是 Home"，第三方桌面也能认出来。
 */
function homePackage(ctx: Context | null): string {
  if (ctx == null) return '';
  try {
    let pm = ctx!.getPackageManager()
    let it = new Intent(Intent.ACTION_MAIN)
    it.addCategory(Intent.CATEGORY_HOME)
    let ri = pm.resolveActivity(it, 0)     // 0 = PackageManager.MATCH_DEFAULT_ONLY
    if (ri == null) return ''
    let ai = ri!.activityInfo
    if (ai == null) return ''
    let p = ai!.packageName
    return p == null ? '' : p!
  } catch (e) {
    return ''
  }
}

/** 无障碍护卫在线（= 有它就不用再要「使用情况访问」） */
function guardUsable(): boolean {
  return guardOn;
}

/**
 * 护卫报上来的包名能不能直接用。
 *
 * 只看"护卫在线 + 报过包名"两件事，**不看时间**。原因见 GUARD_FRESH_SEC 的注释：
 * 窗口事件是变化才发，用户长期停在同一个 App 时本来就不会有新事件，
 * 拿时间当过期判据会把正确的包名误废掉。
 */
function guardFresh(): boolean {
  if (!guardOn) return false;
  return guardPkg.length > 0;
}

/**
 * 护卫的事件流是不是已经静默很久了（久到该拿第二路交叉验证一下）。
 *
 * true 不代表 guardPkg 是错的 —— 只代表"很久没新事件了，值得再问一次系统"。
 * 典型场景：护卫被系统悄悄回收了（guardOn 还是 true，因为 onUnbind 没走到），
 * 这时它会一直报最后一次的包名，而用户早就换 App 了。
 */
function guardStale(): boolean {
  if (!guardOn) return true;
  if (guardPkg.length == 0) return true;
  return (nowSec() - guardAtSec) > GUARD_FRESH_SEC;
}

/**
 * 所有已启用输入法的包名。
 * 它们是"窗口"，但绝不该算跑偏 —— 不看这个名单，用户每打一个字都会被拉回前台。
 * 用系统列出来的实际输入法（而不是写死搜狗/百度那几个），换 ROM 也不会漏。
 */
function imePackages(ctx: Context | null): string[] {
  let out: string[] = [];
  if (ctx == null) return out;
  try {
    let imm = ctx!.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
    let list = imm.getEnabledInputMethodList();
    if (list != null) {
      for (let info of list!) {
        if (info == null) continue;
        let p = info.getPackageName();
        if (p != null && p!.length > 0) out.push(p!);
      }
    }
  } catch (e) {}
  return out;
}

/**
 * 用 UsageStats 问"最近谁被用过"（不是"最近发生过哪些切换"）。
 *
 * ⚠️ 这是 2026-10-15 修的强制模式头号失效点，别改回 queryEvents。
 *
 * 原来的写法是 queryEvents(now - 5s, now) 做事件配对（type 1 进前台 / type 2 离前台）。
 * 问题是：**事件只在切换发生的那一刻产生**。用户切到微信然后停在那儿，
 * 5 秒之后这个窗口里一条事件都没有 → 查出来是空串 → 调用方当成"查不到"直接收手。
 * 表现就是"拉回失败一次，之后再也不拉了"，用户眼里等于强制模式根本没开。
 *
 * queryUsageStats 不一样：它返回"这段时间里用过哪些 App、最后一次用是什么时候"，
 * 跟切没切换无关 —— 用户一直停在微信，微信的 lastTimeUsed 就一直是最大的那个。
 * 代价是精度低一档（分钟级聚合），但对"你现在在不在学习 App 里"这个判断完全够用。
 */
function queryForegroundByUsage(ctx: Context): string {
  try {
    let usm = ctx.getSystemService(Context.USAGE_STATS_SERVICE) as UsageStatsManager
    let end = System.currentTimeMillis()
    let begin = end - 60000        // 字面量：60 秒，Long 运算（Int 常量不会自动放宽）
    let stats = usm.queryUsageStats(4, begin, end)   // 4 = UsageStatsManager.INTERVAL_BEST
    if (stats == null) return ''
    let bestPkg = ''
    // ⚠️ getLastTimeUsed() 返回 Java long。统一折成**秒的 Int** 再比较：
    //    直接拿 Long 跟 Number 比会踩 UTS 的类型坑（Number(x) 是实例化抽象类，编不过）。
    let bestAt: Int = 0
    for (let s of stats!) {
      if (s == null) continue
      let p = s.getPackageName()
      if (p == null) continue
      let t: Int = ((s.getLastTimeUsed() / 1000) as Number).toInt()
      if (t > bestAt) {
        bestAt = t
        bestPkg = p!
      }
    }
    return bestPkg
  } catch (e) {
    return ''
  }
}

/**
 * 查"现在前台是谁"；查不到返回空串（调用方按"失明"处理，不当成合规）。
 *
 * 三条路，从快到慢：
 *   ① 无障碍护卫刚报过（事件驱动，最快最准，且不需要「使用情况访问」）→ 直接采信；
 *   ② 护卫静默太久了 → 拿 UsageStats 交叉验证，查到就以它为准（护卫可能已被系统回收）；
 *   ③ 护卫不在 → 只能用 UsageStats。
 * 全都拿不到才返回空串。
 */
function queryForeground(ctx: Context): string {
  if (guardFresh() && !guardStale()) return guardPkg;

  let byUsage = queryForegroundByUsage(ctx);
  if (byUsage.length > 0) return byUsage;

  // UsageStats 查不到（多半是没授「使用情况访问」）：护卫报过就还是信它，
  // 总比返回空串让人彻底失明好 —— 而且事件流刚发生过的话它大概率是对的。
  if (guardFresh()) return guardPkg;
  return '';
}

/**
 * 把 PWstudy 自己拽回前台。三条路，成败由调用方另判（见 seen 的注释）：
 *   ① ActivityManager.moveTaskToFront —— 自己的 task 提到最前，不重建 Activity，
 *      专注页的计时状态原样留着（需要 REORDER_TASKS，已在清单声明）。
 *   ② launch intent + NEW_TASK|REORDER_TO_FRONT|SINGLE_TOP —— 把已有 Activity 提到最前，
 *      同样不重建。安卓 10 起"后台启动 Activity"被限制，但**无障碍服务被系统绑定**
 *      属于官方豁免清单，护卫开着时这一条才真的拉得动。
 *   ③ 通知的 fullScreenIntent（在 postPullNotify 里另外发，这里只负责 ①②）。
 *
 * @param round 第几次尝试（1 起）。两条路**轮换**：有的 ROM 只认其中一条，
 *              死磕一条会永远拉不动 —— 而用户看到的就是"切走以后毫无反应"。
 *
 * ⚠️ 返回值只表示"这条路的调用没抛异常"，**不代表人已经被拉回来了**
 *    （moveTaskToFront 返回 void，startActivity 也只是把意图交出去）。
 *    真正的成败由下一次心跳看前台变没变（PWFocusService.needOverlay）。
 */
@UTSAndroid.Suppress("DEPRECATION")
function pullSelf(round: Int): boolean {
  // ★ 拦截页（2026-10-15，番茄ToDo 同款）：奇数轮先试它 —— 授权过悬浮窗时它是
  //    唯一真的弹得出来的 startActivity 通路（官方后台启动豁免），弹出后 3 秒倒计时
  //    自动跳回计时页。没授权（或 MIUI 的「后台弹出界面」没开）时它会被**静默**拦掉、
  //    返回 true 是假的 —— 所以只在奇数轮先走它，偶数轮照旧走下面两条老路，
  //    假 true 不会把 moveTaskToFront / launch 永远堵死；遮罩由 needOverlay 兜底照盖。
  if ((round % 2) == 1 && pullByIntercept()) {
    // 刚把拦截页拉起来 → 进入遮罩静默期，别让遮罩抢在它前面盖住（见 INTERCEPT_GRACE_SEC）
    interceptGraceUntilSec = nowSec() + INTERCEPT_GRACE_SEC;
    return true;
  }

  // ⓪ 无障碍豁免通路（2026-10-14 新增，且必须排第一）：
  //    护卫被系统绑定时，从服务内部启动 Activity 才拿得到后台启动豁免 ——
  //    这是四条路里唯一在安卓 10+ 上真的拉得动的。放到最后等于没有：
  //    前面两条"没抛异常"就 return true 了，永远轮不到它。
  let g = guardRef;
  if (g != null) {
    let byGuard: Boolean = false;
    try { byGuard = g.pullFromGuard() } catch (e) { byGuard = false }
    if (byGuard) return true;
  }

  let ctx = UTSAndroid.getAppContext()
  if (ctx == null) return false
  let pkg = ctx!.getPackageName()

  // 轮换：奇数次先 moveTaskToFront，偶数次先 launch intent
  let tryMoveFirst = (round % 2) == 1;
  if (!tryMoveFirst) {
    if (pullByLaunch(ctx!, pkg)) return true;
    if (pullByTask(ctx!, pkg)) return true;
    return false;
  }
  if (pullByTask(ctx!, pkg)) return true;
  if (pullByLaunch(ctx!, pkg)) return true;
  return false;
}

/**
 * ⓪ 拦截页通路：启动自己的全屏黑页（PWPullActivity），它倒计时后自动跳回计时页。
 * 返回 true 只表示"没抛异常"—— 跟 moveTaskToFront 一样拿不到真实成败，
 * 真正的成败由下一次心跳看前台变没变（PWFocusService.needOverlay）。
 */
function pullByIntercept(): boolean {
  try {
    let ctx = UTSAndroid.getAppContext()
    if (ctx == null) return false
    // new 一次只为拿 javaClass —— UTS 会剪掉"没人引用"的声明，
    // PWPullActivity 由系统创建、源码里没有第二个 new，这里就是那个钉住它的引用
    let i = new Intent(ctx!, (new PWPullActivity()).javaClass)
    i.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_SINGLE_TOP)
    // ★ 0,0 = 不要窗口切换动画（2026-10-24）。默认那套缩放/淡入要 200~300ms，
    //   而这一页存在的意义就是"在用户看到桌面之前把它盖住" —— 慢慢淡入等于白做。
    //   拿不到 ActivityOptions（极老 ROM）就退回普通 startActivity，不影响功能。
    try {
      let opts = ActivityOptions.makeCustomAnimation(ctx!, 0, 0)
      ctx!.startActivity(i, opts.toBundle())
    } catch (e) {
      ctx!.startActivity(i)
    }
    return true
  } catch (e) {
    return false
  }
}

/** ① 找自己还在跑的 task，提到前面 */
@UTSAndroid.Suppress("DEPRECATION")
function pullByTask(ctx: Context, pkg: string): boolean {
  try {
    let am = ctx.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
    let tasks = am.getRunningTasks(20)
    if (tasks == null) return false
    // 先按 topActivity 找；有的 ROM 返回空，再按 baseActivity 找一遍
    for (let i = 0; i < 2; i++) {
      for (let t of tasks!) {
        if (t == null) continue
        // 用 == 不用 ===：i 是 Int、字面量 0 会被装箱成 Number，
        // 引用相等（===）在装箱后不稳定 —— kotlin 会警告 implicit boxing
        let cn = i == 0 ? t.topActivity : t.baseActivity
        if (cn != null && cn!.getPackageName() == pkg) {
          am.moveTaskToFront(t.id, 0)
          return true
        }
      }
    }
  } catch (e) {
    // 被 ROM 拦了 / 拿不到 task 列表 → 走兜底
  }
  return false;
}

/**
 * ② 用 launch intent 把自己提到最前。
 * REORDER_TO_FRONT + SINGLE_TOP 保证**不重建** Activity —— 专注页正在跑的计时
 * 状态原样留着，这也是"验证路径"里"状态不丢失"那一条的落点。
 */
function pullByLaunch(ctx: Context, pkg: string): boolean {
  try {
    let launch = ctx.getPackageManager().getLaunchIntentForPackage(pkg)
    if (launch == null) return false
    launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP)
    ctx.startActivity(launch)
    return true
  } catch (e) {
    return false
  }
}

function serviceIntent(ctx: Context): Intent {
  return new Intent(ctx, (new PWFocusService()).javaClass)
}

/** 起服务（服务已在跑时重复调用只是再触发一次 onStartCommand，天然幂等） */
function startServiceWith(ctx: Context, intent: Intent): boolean {
  try {
    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
      ctx.startForegroundService(intent)
    } else {
      ctx.startService(intent)
    }
    return true
  } catch (e) {
    return false
  }
}

/* ==================== 对外 API ==================== */

/**
 * 启动前台服务（专注开始时调用）。
 * 服务已在跑时重复调用只是再触发一次 onStartCommand —— 顺带刷新文案，天然幂等。
 */
export function startFocusService(title: string, text: string): boolean {
  let ctx = UTSAndroid.getAppContext()
  if (ctx == null) return false
  let intent = serviceIntent(ctx!)
  intent.putExtra('title', title)
  intent.putExtra('text', text)
  if (!startServiceWith(ctx!, intent)) {
    console.error('pwstudy-focus: startForegroundService 失败')
    return false
  }
  return true
}

/** 只刷新常驻通知文案（通知 id 与服务持久的同一条，倒计时每 30 秒刷一次） */
export function updateFocusNotification(title: string, text: string): boolean {
  let ctx = UTSAndroid.getAppContext()
  if (ctx == null) return false
  try {
    let manager = ctx!.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    manager.notify(NOTIFY_ID, buildNotification(ctx!, title, text))
    return true
  } catch (e) {
    return false
  }
}

/** 停止前台服务并移除常驻通知（专注结束 / 放弃时调用） */
export function stopFocusService(): boolean {
  let ctx = UTSAndroid.getAppContext()
  if (ctx == null) return false
  try {
    ctx!.stopService(serviceIntent(ctx!))
    return true
  } catch (e) {
    return false
  }
}

/** 探测：能调到这里说明插件的原生代码已经打进包里（自定义基座 / 云打包） */
export function isAvailable(): boolean {
  return UTSAndroid.getAppContext() != null
}

/**
 * 强制模式：配置后台看门狗。
 *
 * on = false 时立即收手（撤遮罩、撤拉回通知、停线程）—— 用户暂停/放弃/结束专注、
 * 或关掉强制模式，都必须走这里，否则会出现"专注都结束了还在拉人"的鬼故事。
 *
 * untilSec 是兜底的自动收手时间（= 这段专注还剩多少秒）：JS 在后台可能被冻结，
 * 光靠它来通知停手不可靠，所以原生自己也掐着表。
 */
export function setWatch(on: boolean, allowCsv: string, untilSec: Int): boolean {
  let ctx = UTSAndroid.getAppContext()
  if (ctx == null) return false
  let intent = serviceIntent(ctx!)
  intent.putExtra('watch', on ? 1 : 0)
  intent.putExtra('allow', allowCsv)
  intent.putExtra('untilSec', untilSec)
  if (!startServiceWith(ctx!, intent)) return false
  return true
}

/** 强制模式战绩：拉回次数（JS 侧拿来显示"已拉回 N 次"） */
export function watchPulls(): number {
  return watchPullCount
}

/** 强制模式战绩：逃逸次数（连续离开学习 App 的"次"，JS 侧拿它判 3 次作废） */
export function watchEscapes(): number {
  return watchEscapeCount
}

/** 清零战绩（每轮专注开始时调一次） */
export function resetWatchStats(): boolean {
  watchPullCount = 0
  watchEscapeCount = 0
  return true
}

/**
 * 强制模式用：把 PWstudy 自己拉回前台（JS 侧兜底调用）。
 * 优先 moveTaskToFront（复用已有 task，专注页状态不丢），失败再退回 launch intent。
 * 被系统 / ROM 拦住时返回 false —— 调用方照常发通知，不假装锁得住。
 */
export function bringToFront(): boolean {
  return pullSelf(1)
}

/** 有没有"拉回前台"的原生能力（标准基座返回 false） */
export function bringToFrontSupported(): boolean {
  return UTSAndroid.getAppContext() != null
}

/**
 * 无障碍豁免通路现在可用吗（护卫被系统绑定 + 拿到服务实例）。
 *
 * 给 JS 侧的能力盘点用：以前 `canPullBack = native && (a11y || overlay)`，
 * 只要用户在系统设置里开了无障碍就报 true，但实际拉不动（缺的正是这条通路），
 * 状态条于是长期"说谎"。现在把"豁免通路在不在"单独报出来，界面才说得准。
 */
export function a11yPullReady(): boolean {
  return guardRef != null && guardOn;
}

/**
 * 前台服务现在是否真的活着（看门狗的载体）。
 *
 * 判据是 svcRef —— 它在 PWFocusService.onCreate 里赋值、onDestroy 里清空。
 * 服务被系统杀掉时进程也一起没了，新进程里这个标志自然是 null，
 * 所以"进程内标志"在这个场景里够用，不需要去问 ActivityManager.getRunningServices
 * （那个 API 26 起就对三方应用关闭了，问了也永远拿不到自己）。
 *
 * JS 侧拿它做什么：utils/forced.js 原来只记"我推过配置"（pushedOn），
 * 服务真被杀了它还以为有人在盯，于是 JS 兜底轮询也让位 —— 两头没人管。
 */
export function serviceAlive(): boolean {
  return svcRef != null;
}

/** 原生侧实测的悬浮窗权限（JS 侧 utils/apptime.js 也有一份，两个都要有 ——
 *  遮罩是原生挂的，判定必须以原生这一份为准） */
export function overlayGranted(): boolean {
  // ⚠️ canDrawOverlays 收非空 Context；getAppContext() 是可空的。
  //    直接透传 = Kotlin 报 Argument type mismatch（云打包 2026-10-15 实测炸在
  //    compileReleaseKotlin）。canDrawOverlays 的其余调用点都写 ctx! 就是这个原因。
  let ctx = UTSAndroid.getAppContext();
  return ctx != null && canDrawOverlays(ctx!);
}

/**
 * 强制模式的**自检快照**（JSON 字符串）。
 *
 * 为什么要有这个：强制模式"看着完全没反应"已经来回好几轮了，而这条链有十几环
 * （前台服务 → 看门狗 → 探测前台 → 判定跑偏 → 拉回 → 遮罩），任何一环断掉都表现成
 * 同一个"没反应"。与其每轮猜一次，不如让界面能把每一环的实测值直接列出来。
 *
 * 为什么返回字符串而不是对象：UTS 的对象类型在跨语言边界上很容易踩坑
 * （字段被裁剪 / 类型推断成 Number），拼 JSON 串是唯一稳的写法。
 */
export function watchDiag(): string {
  let s = svcRef;
  let watch = '0';
  let episode = '0';
  let tries = '0';
  let blind = '0';
  let allowN = '0';
  if (s != null) {
    try { watch = s.watchOn ? '1' : '0' } catch (e) {}
    try { episode = s.inEpisode ? '1' : '0' } catch (e) {}
    try { tries = '' + s.pullTries } catch (e) {}
    try { blind = '' + s.blindTicks } catch (e) {}
    try { allowN = '' + s.allowCsv.split(',').length } catch (e) {}
  }
  let ctx = UTSAndroid.getAppContext();
  let fg = '';
  let home = '';
  if (ctx != null) {
    try { fg = queryForeground(ctx!) } catch (e) {}
    // 系统默认桌面是哪个包（只作诊断：桌面**不算**合规，见 setWatch 的注释）
    try { home = homePackage(ctx!) } catch (e) {}
  }
  // 探测来源：护卫刚报过 = 无障碍事件；否则 = UsageStats；都拿不到 = 失明
  let src = 'blind';
  if (fg.length > 0) src = (guardFresh() && !guardStale()) ? 'a11y' : 'usage';
  return '{"svc":' + (svcRef != null ? '1' : '0') +
    ',"watch":' + watch +
    ',"fg":"' + fg + '"' +
    ',"home":"' + home + '"' +
    // 前台是不是桌面：是就该拉回（以前桌面被当成合规，这条能一眼看出"为什么没拦"）
    ',"atHome":' + (fg.length > 0 && home.length > 0 && fg == home ? '1' : '0') +
    ',"src":"' + src + '"' +
    ',"episode":' + episode +
    ',"tries":' + tries +
    ',"blind":' + blind +
    ',"allowN":' + allowN +
    ',"pulls":' + watchPullCount +
    ',"escapes":' + watchEscapeCount +
    // 同 overlayGranted：ctx 可空，canDrawOverlays 收非空 —— 判空短路再断言
    ',"ovGrant":' + (ctx != null && canDrawOverlays(ctx!) ? '1' : '0') +
    ',"ovWanted":' + (overlayWanted ? '1' : '0') +
    ',"ovOn":' + (overlayView != null ? '1' : '0') +
    ',"a11y":' + (guardOn ? '1' : '0') +
    ',"a11yEv":' + guardEvents +
    ',"tripped":' + (a11yTripped ? '1' : '0') + '}';
}

/* ==================== 无障碍护卫：对外 API ==================== */

/**
 * 无障碍护卫是否已开启。
 *
 * ⚠️ 关键改动：这里**绝不在调用线程上做跨进程查询**。
 * 原来的写法直接问 AccessibilityManager.getEnabledAccessibilityServiceList()，
 * 那是一次**同步 Binder 调用** —— 用户刚在系统设置里打开开关的那一刻，
 * system_server 正在 bind 我们的服务、等它的 onServiceConnected 回来（回调在 APP 主线程），
 * 而我们的主线程又在等 system_server 返回列表……两边互相等，一次教科书式的死锁，
 * 界面直接冻住。真机上"开了无障碍回来就死机"，这是主要贡献者之一。
 *
 * 现在的口径：
 *   · 服务连上了（guardOn 是进程内布尔，零 IPC）→ 就是开了，立刻返回 true；
 *   · 没连上 → 返回后台线程上次刷到的值（a11yListed），同时异步再刷一次，下次调用就有。
 */
export function a11yEnabled(): boolean {
  if (guardOn) {
    maybeClearBind();      // 服务稳定跑过一阵子 → 清掉 bind 计数，别让历史累计误伤
    return true;
  }
  scheduleA11yQuery();
  return a11yListed;
}

/** 服务连上超过 30 秒视为"这次是稳的" → 把窗口内的 bind 次数清零（只清一次） */
const A11Y_STABLE_SEC: Int = 30;
let a11yCleared = false;
function maybeClearBind(): void {
  if (a11yCleared) return;
  if (nowSec() - guardConnAtSec < A11Y_STABLE_SEC) return;
  a11yCleared = true;
  clearBind();
}

/** 后台线程刷一次"系统启用名单里有我"，结果放进 a11yListed 供下次读取 */
function scheduleA11yQuery(): void {
  if (a11yQuerying) return;
  if (nowSec() - a11yListedAt < 2) return;      // 2 秒内刚刷过就别刷
  a11yQuerying = true;
  try {
    let th = new A11yQueryThread();
    th.start();
  } catch (e) {
    a11yQuerying = false;
  }
}

class A11yQueryThread extends Thread {
  // ⚠️ 这个空构造函数必须写，别删。
  // UTS 把 `extends X` 生成 Kotlin 的 `class A11yQueryThread : Thread`（**不带括号**），
  // Kotlin 要求父类在声明处被初始化 —— 靠显式构造函数里的 super() 来补。
  // 一旦这个类没有显式构造函数，就没人调 super()，云端直接编不过：
  //   e: index.kt:841:30 This type has a constructor, so it must be initialized here.
  // 同文件另外三个 extends 类（PWFocusService / WatchLoop / PullOverlay）都写了显式构造，
  // 所以只有这一处踩到。
  constructor() {
    super();
  }

  override run(): void {
    try {
      a11yListed = queryA11yListed();
      a11yListedAt = nowSec();
    } catch (e) {
    } finally {
      a11yQuerying = false;
    }
  }
}

function queryA11yListed(): boolean {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return false;
  let am = ctx!.getSystemService(Context.ACCESSIBILITY_SERVICE) as AccessibilityManager
  let list = am.getEnabledAccessibilityServiceList(-1);   // -1 = FEEDBACK_ALL_MASK
  if (list == null) return false;
  let self = ctx!.getPackageName();
  for (let s of list!) {
    if (s == null) continue;
    let id = s.getId();
    if (id != null && id!.indexOf(self) == 0) return true;
  }
  return false;
}

/** 保险丝有没有跳过闸（界面据此提示"这个 ROM 上起不来"） */
export function a11ySafe(): boolean {
  return !a11yTripped;
}

/** 重置保险丝（设置页"再试一次"） */
export function resetA11y(): boolean {
  a11yTripped = false;
  a11yCleared = false;
  clearBind();
  return true;
}

/** 护卫当前是否已连上（系统绑定成功，正在收窗口事件） */
export function a11yActive(): boolean {
  return guardOn;
}

/** 护卫累计收到的窗口事件数（诊断 / 状态行显示"它确实在干活"） */
export function a11yEvents(): number {
  return guardEvents;
}

/** 护卫最近报上来的前台包名（空串 = 还没报过） */
export function a11yPkg(): string {
  return guardPkg;
}

/**
 * 跳系统的「无障碍」设置页。
 *
 * ⚠️ 安卓 13+ 对**侧载**安装的应用有「受限设置」闸门：用户得先
 * 「应用信息 → 右上角 ⋮ → 允许受限设置」，无障碍列表里才勾得上本服务。
 * 这一步系统有意不给捷径，只能靠引导文案讲清楚（见 utils/apptime.js 里的说明）。
 */
export function openA11ySettings(): boolean {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return false;
  try {
    let it = new Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS);
    // 同 openNotifSettings（2026-10-29）：REORDER_TO_FRONT 把已在后台的 Settings task
    // 提到最前，避免从 Application Context 启动时整页卡在后台、用户以为"点了没反应"。
    it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP);
    ctx!.startActivity(it);
    return true;
  } catch (e) {
    return false;
  }
}

/* ==================== 专注期拦截通知（通知使用权） ====================
 *
 * 番茄ToDo 的做法（2026-10-15 视频 + 用户截图实测）：
 *   专注期间把别家 App 的通知**捕获并当场撤下**（下拉通知栏也看不到），
 *   专注结束再把攒下的汇总成一条"已拦截(应用)的通知"发出来（用户截图同款）。
 *
 * 这条路只有一个入口 —— NotificationListenerService（系统的「通知使用权」）。
 * ⚠️ 为什么不用免打扰（setInterruptionFilter）：它只能压掉通知，
 *    **拿不到内容**，结束时想汇总就做不了 —— 方案必须是监听服务。
 *
 * 与无障碍护卫同款的三件事：
 *   · 权限是运行时授权：用户要在「设置 → 通知使用权」里亲手给（装机即不得）
 *   · 服务由系统创建：生成 Kotlin 会剪掉"没人引用"的类，靠 keepNotifClass() 钉住
 *   · 只读标题/正文并暂时收起，不改内容、不回发、不上传
 */

const NOTIF_MAX: Int = 30;          // 最多记多少条：再多就是刷屏轰炸，汇总失去意义
const NOTIF_TEXT_MAX: Int = 60;     // 单条截断：通知正文经常超长，汇总里只留个开头

let notifOn: boolean = false;
let notifList: Array<string> = [];

/** 用户有没有把「通知使用权」给 PWstudy */
export function notifGranted(): boolean {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return false;
  try {
    let raw = Settings.Secure.getString(ctx!.getContentResolver(), 'enabled_notification_listeners');
    if (raw == null || raw == '') return false;
    return raw.indexOf(ctx!.getPackageName()) >= 0;
  } catch (e) {
    return false;
  }
}

/**
 * 跳系统的「通知使用权」设置页。
 *
 * ⚠️ 2026-10-25 真机实锤：只给一条路时部分 ROM（MIUI / 澎湃等对设置页跳转有白名单）
 * 会 resolve 失败或直接吞掉 → startActivity 抛异常 → JS 层弹"没跳过去"，
 * 用户眼里就是这个开关开不了。跟白噪音 srcCandidates 同一条教训：
 * **必须给多条路径，且某条失败不吐错就换下一条**。
 *
 * 三级兜底：
 *   ① 直达「通知使用权」列表页（标准 action，绝大多数机型到这就够了）；
 *   ② 退到系统设置主页 —— 用户按弹窗文案自己点两下（设置 → 通知 → 通知使用权）；
 *   ③ 再退到本 App 的应用详情页 —— 有的 ROM 把"通知使用权"也挂在详情页入口下。
 * 只要有一条走通就返回 true；三条全挂才让 JS 层去说"跳不过去"。
 */
/**
 * 启动系统设置类 intent 的统一步骤：先 resolveActivity 确认能解析到真实 Activity，
 * 再 startActivity。两道保险对应「点了没效果」的两个根因：
 *   ① 旗标 NEW_TASK | REORDER_TO_FRONT | SINGLE_TOP —— REORDER_TO_FRONT 把已在后台的
 *      Settings task 提到最前，避免从 Application Context 启动时整页卡在后台、用户以为没反应
 *      （本插件拉回页用的同款组合，实测可靠）；
 *   ② 解析不到就不启动、别假称成功，让调用方的下一档兜底上（避免"返回 true 却什么都没弹"）。
 */
function launchSettings(ctx: Context | null, it: Intent): boolean {
  it.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_REORDER_TO_FRONT | Intent.FLAG_ACTIVITY_SINGLE_TOP);
  try {
    if (ctx!.getPackageManager().resolveActivity(it, 0) == null) return false;
  } catch (e) { return false; }
  try { ctx!.startActivity(it); return true; } catch (e) { return false; }
}

export function openNotifSettings(): boolean {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return false;
  // ① 直达「通知使用权」
  if (launchSettings(ctx, new Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS))) return true;
  // ② 系统设置主页
  if (launchSettings(ctx, new Intent(Settings.ACTION_SETTINGS))) return true;
  // ③ 本 App 的应用详情页（package: 前缀的 data，不依赖任何 ROM 私有 action）
  try {
    let it3 = new Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS);
    it3.setData(Uri.parse('package:' + ctx!.getPackageName()));
    if (launchSettings(ctx, it3)) return true;
  } catch (e) {}
  return false;
}

/** 开始拦截。没授权返回 false —— JS 层据此绝不承诺"已经帮你挡住了" */
export function interceptStart(): boolean {
  if (!notifGranted()) return false;
  notifList = [];
  notifOn = true;
  return true;
}

/** 已经拦了几条（界面显示"这段专注挡住了多少"用） */
export function interceptCount(): Int {
  return (notifList.length as Number).toInt();
}

/** 结束拦截：返回攒到的列表 JSON（[{app,title,text}]），标记一并收掉 */
export function interceptEnd(): string {
  notifOn = false;
  let out = JSON.stringify(notifList);
  notifList = [];
  return out;
}

class PWNotifListener extends NotificationListenerService {
  constructor() {
    super();
  }

  override onNotificationPosted(sbn: StatusBarNotification | null): void {
    super.onNotificationPosted(sbn);
    if (sbn == null) return;
    if (!notifOn) return;
    // 自己发的通知不拦：常驻倒计时本来就该看得见
    if (sbn.getPackageName() == this.getPackageName()) return;
    let app = sbn.getPackageName();
    let title = '';
    let text = '';
    try {
      let ex = sbn.getNotification().extras;
      let t1 = ex.getCharSequence(Notification.EXTRA_TITLE);
      let t2 = ex.getCharSequence(Notification.EXTRA_TEXT);
      if (t1 != null) title = t1.toString();
      if (t2 != null) text = t2.toString();
    } catch (e) {}
    if (title.length > NOTIF_TEXT_MAX) title = title.substring(0, NOTIF_TEXT_MAX);
    if (text.length > NOTIF_TEXT_MAX) text = text.substring(0, NOTIF_TEXT_MAX);
    if (notifList.length < NOTIF_MAX) {
      notifList.push(JSON.stringify({ app: app, title: title, text: text }));
    }
    // 当场撤下 = 下拉通知栏也看不到（这就是"屏蔽通知"的实际机制）
    try { this.cancelNotification(sbn.getKey()); } catch (e) {}
  }
}

/** 钉住监听类：UTS 会剪掉"没人引用"的声明，系统创建的类靠这里的 new 保住 */
export function keepNotifClass(): boolean {
  return (new PWNotifListener()) != null;
}

/* ==================== 白噪音原生播放（后台不中断）====================
 *
 * 为什么不用 uni.createInnerAudioContext 播循环白噪音：它在 App 端底层仍挂在
 * WebView 的音频上下文上，App 退到后台（用户切到别的 App、只剩前台服务 + 灵动岛胶囊）
 * 时 WebView 被回收/挂起，上下文没了 → 播放报错 errCode -5（MEDIA_ERROR_UNKNOWN），
 * 表现就是"在里面播得好好的，切出去就 -5"。
 *
 * 这里改用原生 android.media.MediaPlayer，直接吃本地 wav 绝对路径：
 *   · 不挂在 WebView 上，App 后台（前台服务还活着）照样播，解决 -5；
 *   · setLooping(true) 做无缝循环；
 *   · setVolume(vol, vol) 做**单路**音量（0.32 这种"垫底背景音"必须压得住，
 *     否则会盖过注意力）—— 这也是 InnerAudioContext 给不到的；
 *   · 用 Application Context 创建、不随 Activity 销毁而释放；专注期前台服务保活，
 *     进程不被回收，MediaPlayer 自然也不死。
 */

let ambientMP: MediaPlayer | null = null;
let ambientErrCode: Int = 0;
let ambientErrMsg: String = '';

class AmbientErrorListener implements MediaPlayer.OnErrorListener {
  onError(mp: MediaPlayer, what: Int, extra: Int): Boolean {
    ambientErrCode = extra != 0 ? extra : what;
    ambientErrMsg = 'media error what=' + what + ' extra=' + extra;
    return true;  // 阻止系统再发一次 onCompletion，避免循环被打断
  }
}

/**
 * 开始/切换循环播放。absPath 为本地 wav 的**绝对路径**（audio.localUrl 转出来的那种）。
 * volume 0~1（默认 0.32）；loop=true 循环。返回 0=发起成功，-1=异常，-2=无上下文。
 */
export function ambientStart(absPath: string, volume: number, loop: boolean): Int {
  try {
    ambientStopInternal();
    let ctx = UTSAndroid.getAppContext();
    if (ctx == null) { ambientErrCode = -2; ambientErrMsg = 'no app context'; return -2; }
    let mp = new MediaPlayer();
    mp.setAudioStreamType(AudioManager.STREAM_MUSIC);
    mp.setDataSource(absPath);
    mp.setLooping(loop);
    mp.setVolume(volume.toFloat(), volume.toFloat());
    mp.setOnErrorListener(new AmbientErrorListener());
    ambientMP = mp;
    ambientErrCode = 0;
    ambientErrMsg = '';
    mp.prepare();
    mp.start();
    return 0;
  } catch (e) {
    ambientErrCode = -1;
    ambientErrMsg = 'ambient init failed';
    console.error('pwstudy-focus: ambientStart 初始化失败', e);
    return -1;
  }
}

export function ambientPause(): void {
  try { if (ambientMP != null) ambientMP!.pause(); } catch (e) {}
}

export function ambientResume(): void {
  try { if (ambientMP != null) ambientMP!.start(); } catch (e) {}
}

export function ambientStop(): void {
  ambientStopInternal();
}

function ambientStopInternal(): void {
  try {
    if (ambientMP != null) {
      try { ambientMP!.stop(); } catch (e) {}
      try { ambientMP!.release(); } catch (e) {}
    }
  } catch (e) {}
  ambientMP = null;
}

/** 最近一次错误（空串 = 没出错）。JS 层据此给界面提示 */
export function ambientError(): string {
  if (ambientErrCode == 0) return '';
  return '' + ambientErrCode + ':' + ambientErrMsg;
}

/* ==================== 休闲提醒后台检测（LeisureGuard）====================
 *
 * 多邻国式提醒的「真·后台」一腿：即使 App 关着、用户在抖音里，也能周期检测
 * 当前前台 + 当日累计休闲时长，到点复盘。为什么必须下沉到原生：JS 在 App 退后台后
 * 定时器被挂起（跟强制模式看门狗同一个理由）。
 *
 * 机制（照抄现有 PWNotifListener / PFGuardService 的「系统创建类要钉住」规矩）：
 *   · 一个 BroadcastReceiver（LeisureGuard）+ AlarmManager 周期闹钟。
 *   · 闹钟走 setAndAllowWhileIdle（RTC_WAKEUP，**不精确**——精确闹钟要 SCHEDULE_EXACT_ALARM，
 *     安卓 12+ 会 SecurityException，见 scheduleLeisureAlarm 的注释），到点唤醒进程跑一段检测；
 *     检测完**自己再排下一次**（自续约，比 setRepeating 更准，且能跨午夜）。
 *   · BOOT_COMPLETED / MY_PACKAGE_REPLACED 也进同一个 receiver，重启/升级后自动重挂。
 *   · 配置（含阈值/静默时段/复盘时点/各类文案模板）整段存进 SharedPreferences，
 *     这样 receiver 在「独立进程」里被唤醒时，不必依赖 App 主进程的内存状态也能工作。
 *   · 节流（每天最多 maxPerDay 条、同一种提醒当天只发一次）也存 SP，跨进程/跨唤醒保留。
 *   · 没有「使用情况访问」权限时直接收手（不读不到就别瞎提醒）；与 JS 侧 decide 同口径。
 *
 * 三条提醒（优先级 dwell → daily → digest，每天每种至多一条）：
 *   dwell ：现在前台正好是某个休闲 App，且它当日累计 >= dwellMin（"你正在刷抖音"）。
 *   daily ：当天零专注 且 休闲累计 >= dailyMin（靠 SP 里 leisure_focus_date 判零专注）。
 *   digest：复盘开关开 且 已过 digestTime（时间到了，提醒还有任务没做）。
 *
 * ⚠️ 与 JS 的 maybeNudgeOnOpen 是两条并行的腿：打开 App 时那条永远工作（兜底），
 *   原生这条负责"App 关着也推"。两条共享同一套阈值与静默，原生会再核一遍。
 */

const LEISURE_SP = 'pw_leisure';
const LEISURE_NOTIFY_ID: Int = 8820;          // 与 8801/8802/8810/8860 错开
const CHANNEL_LEISURE = 'pw_leisure_remind';
const LEISURE_ALARM_ACTION = 'io.dcloud.uni_modules.pwstudy_focus.LEISURE_ALARM';
const LEISURE_ALARM_REQ: Int = 88020;         // PendingIntent requestCode
const LEISURE_PERIOD_MS: Int = 900000;        // 15 分钟周期（毫秒，只对 Long 做加法）
const LEISURE_PERIOD_SEC: Int = 900;          // 同一周期的秒口径（SP 里只存 Int 秒，别碰 Long）

/** 闹钟 PendingIntent 标志：API 23+ 必须 IMMUTABLE，更老的只有 UPDATE_CURRENT */
function piFlags(): Int {
  if (Build.VERSION.SDK_INT >= 23) return PI_FLAGS;
  return 0x08000000;   // FLAG_UPDATE_CURRENT
}

/** LeisureGuard 的配置（从 SP 里的 JSON 解析出来） */
class LeisureCfg {
  on: boolean = false;
  pkgs: Array<string> = [];
  names: Array<string> = [];
  dwellMin: Int = 30;
  dailyMin: Int = 120;
  quietFrom: Int = 22;
  quietTo: Int = 8;
  maxPerDay: Int = 3;
  digest: boolean = false;
  digestTime: string = '20:00';        // 仅留档/排查用，判定不读它
  digestHm: Int = 1200;                // 复盘时点折算成「小时*60+分钟」，20:00
  remaining: Int = 0;
  dwellTitle: string = '';
  dwellMsg: string = '';
  dwellTail: string = '';
  dailyTitle: string = '';
  dailyMsg: string = '';
  digestTitle: string = '';
  digestMsg: string = '';
}

/** 节流状态（跨唤醒保留在 SP） */
class LeisureThrottle {
  date: string = '';
  count: Int = 0;
  kinds: Array<string> = [];
}

function leisureSp(): SharedPreferences | null {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return null;
  return ctx!.getSharedPreferences(LEISURE_SP, 0);
}

/** 本地时区的 "YYYY-MM-DD" */
function leisureDateStr(): string {
  try {
    let cal = Calendar.getInstance();
    let y = cal.get(Calendar.YEAR);
    let m = cal.get(Calendar.MONTH) + 1;
    let d = cal.get(Calendar.DAY_OF_MONTH);
    let ms = (m < 10) ? ('0' + m.toString()) : m.toString();
    let ds = (d < 10) ? ('0' + d.toString()) : d.toString();
    return y.toString() + '-' + ms + '-' + ds;
  } catch (e) {
    return '';
  }
}

/** 本地时区当前的 "小时*60+分钟" */
function leisureNowHm(): Int {
  try {
    let cal = Calendar.getInstance();
    let h = cal.get(Calendar.HOUR_OF_DAY);
    let m = cal.get(Calendar.MINUTE);
    return h * 60 + m;
  } catch (e) {
    return 1200;
  }
}

/**
 * 解析 armGuard 预渲染的 JSON 配置。全程 try：任何字段缺失都退化成默认值，
 * 绝不因为一条提醒解析失败就让整个检测崩溃（提醒是锦上添花，不该拖垮别的）。
 */
function parseLeisureCfg(json: string): LeisureCfg {
  let c = new LeisureCfg();
  try {
    let o = new JSONObject(json);
    c.dwellMin = o.optInt('dwellMin', 30);
    c.dailyMin = o.optInt('dailyMin', 120);
    c.quietFrom = o.optInt('quietFrom', 22);
    c.quietTo = o.optInt('quietTo', 8);
    c.maxPerDay = o.optInt('maxPerDay', 3);
    c.digest = o.optBoolean('digest', false);
    c.digestTime = o.optString('digestTime', '20:00');
    c.digestHm = o.optInt('digestHm', 1200);
    c.remaining = o.optInt('remaining', 0);
    c.dwellTitle = o.optString('dwellTitle', '');
    c.dwellMsg = o.optString('dwellMsg', '');
    c.dwellTail = o.optString('dwellTail', '');
    c.dailyTitle = o.optString('dailyTitle', '');
    c.dailyMsg = o.optString('dailyMsg', '');
    c.digestTitle = o.optString('digestTitle', '');
    c.digestMsg = o.optString('digestMsg', '');
    let pkgsArr = o.optJSONArray('pkgs');
    let namesArr = o.optJSONArray('names');
    if (pkgsArr != null) {
      let n = pkgsArr.length();
      var i: Int = 0;
      while (i < n) {
        let v = pkgsArr.optString(i, '');
        c.pkgs.push(v);
        let nm = '';
        if (namesArr != null) nm = namesArr.optString(i, '');
        c.names.push(nm);
        i++;
      }
    }
  } catch (e) {}
  return c;
}

/** 从 SP 读出当前配置；关着 / 没配置 返回 null */
function loadLeisureCfg(): LeisureCfg | null {
  let p = leisureSp();
  if (p == null) return null;
  if (p.getInt('leisure_on', 0) != 1) return null;
  let payload = p.getString('leisure_payload', '')!;
  if (payload.length == 0) return null;
  return parseLeisureCfg(payload);
}

/** 读节流状态，并自动按天重置 */
function loadLeisureThrottle(): LeisureThrottle {
  let st = new LeisureThrottle();
  let p = leisureSp();
  if (p == null) return st;
  let date = p.getString('leisure_ndate', '')!;
  let count = p.getInt('leisure_ncount', 0);
  let ks = p.getString('leisure_nkinds', '')!;
  if (ks.length > 0) {
    let arr = ks.split(',');
    for (let i = 0; i < arr.length; i++) {
      if (arr[i].length > 0) st.kinds.push(arr[i]);
    }
  }
  let today = leisureDateStr();
  if (date != today) {
    st.date = today;
    st.count = 0;
    st.kinds = [];
  } else {
    st.date = date;
    st.count = count;
  }
  return st;
}

function saveLeisureThrottle(st: LeisureThrottle): void {
  let p = leisureSp();
  if (p == null) return;
  // 手工拼逗号串：UTS 的 Array 没有 JS 的 join()（落到 Kotlin 会编不过）
  let parts = '';
  for (let i = 0; i < st.kinds.length; i++) {
    if (parts.length > 0) parts = parts + ',';
    parts = parts + st.kinds[i];
  }
  try {
    p.edit().putString('leisure_ndate', st.date)
      .putInt('leisure_ncount', st.count)
      .putString('leisure_nkinds', parts)
      .apply();
  } catch (e) {}
}

/** 今日是否已有过专注（靠 SP 里 leisure_focus_date） */
function leisureFocusToday(): boolean {
  let p = leisureSp();
  if (p == null) return false;
  let d = p.getString('leisure_focus_date', '')!;
  return d == leisureDateStr();
}

/** 静默时段判定（跨午夜） */
function leisureInQuiet(c: LeisureCfg, hm: Int): boolean {
  let a = c.quietFrom * 60;
  let b = c.quietTo * 60;
  if (a == b) return false;
  if (a < b) return hm >= a && hm < b;
  return hm >= a || hm < b;
}

/**
 * 是否已过复盘时点。
 * 时点由 JS 侧折算成「小时*60+分钟」的整数传进来（digestHm），
 * 这里不做 "20:00".split(':') → Number() 的解析 —— `Number(x)` 在生成的 Kotlin
 * 里是实例化抽象类 java.lang.Number，云打包直接编不过（见 bumpBind 上方注释）。
 */
function leisurePastDigest(c: LeisureCfg): boolean {
  return leisureNowHm() >= c.digestHm;
}

/** 把 s 里所有 {key} 换成 val（手工拼接，UTS 的 Array 没有 join） */
function leisureFill(s: string, key: string, val: string): string {
  let token = '{' + key + '}';
  let arr = s.split(token);
  if (arr.length <= 1) return s;
  let out = '';
  for (let i = 0; i < arr.length; i++) {
    if (i > 0) out = out + val;
    out = out + arr[i];
  }
  return out;
}

/** 占位符替换：{app} {min} {total} {n}（不认识的占位符原样留着） */
function leisureTpl(s: string, app: string, min: Int, total: Int, n: Int): string {
  let out = leisureFill(s, 'app', app);
  out = leisureFill(out, 'min', min.toString());
  out = leisureFill(out, 'total', total.toString());
  out = leisureFill(out, 'n', n.toString());
  return out;
}

/**
 * 读当天每个休闲包的前台累计分钟（与当天 0 点对齐，不是"最近 24 小时"）。
 * 返回数组与 c.pkgs 下标对齐。读不到（没权限 / 异常）返回全 0。
 *
 * 口径与 JS 侧 utils/apptime.js 的 usageByStats 一致：INTERVAL_DAILY(0) +
 * getTotalTimeInForeground()。不去实现事件流配对那条降级路 ——
 * 少数 ROM 上 queryUsageStats 会返回空（apptime 那边就靠事件流兜），
 * 这里读不到就全 0：**不发提醒**。宁可少提醒，也不能拿错数字瞎催人；
 * 而且这种机器上一打开 App 那条 JS 路径（有事件流兜底）照样会提醒。
 */
function leisureDayUsage(ctx: Context, pkgs: Array<string>): Array<Int> {
  let out: Array<Int> = [];
  for (let i = 0; i < pkgs.length; i++) out.push(0);
  try {
    let usm = ctx.getSystemService(Context.USAGE_STATS_SERVICE) as UsageStatsManager
    let cal = Calendar.getInstance();
    cal.set(Calendar.HOUR_OF_DAY, 0);
    cal.set(Calendar.MINUTE, 0);
    cal.set(Calendar.SECOND, 0);
    cal.set(Calendar.MILLISECOND, 0);
    let begin = cal.getTimeInMillis();
    let endMs = System.currentTimeMillis();
    let stats = usm.queryUsageStats(0, begin, endMs)   // 0 = INTERVAL_DAILY
    if (stats != null) {
      for (let s of stats!) {
        if (s == null) continue;
        let p = s.getPackageName();
        if (p == null) continue;
        let ms: Int = ((s.getTotalTimeInForeground() / 60000) as Number).toInt();
        for (let j = 0; j < pkgs.length; j++) {
          if (pkgs[j] == p) out[j] = out[j] + ms;
        }
      }
    }
  } catch (e) {}
  return out;
}

/**
 * 通知到底能不能弹出去。
 * ⚠️ 安卓 13+ 没授 POST_NOTIFICATIONS（或用户在系统里把通知关了）时，
 *    NotificationManager.notify() **不抛异常、也不弹**，静默无效。
 *    不判这一下，我们就会以为"发出去了"，把当天的节流配额白白烧掉，
 *    用户却一条也没看见 —— 最典型的"功能看着开了其实没干活"。
 */
function notifAllowed(ctx: Context): boolean {
  try {
    if (Build.VERSION.SDK_INT < 24) return true
    let nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    return nm.areNotificationsEnabled()
  } catch (e) {
    return true
  }
}

/** 建休闲提醒渠道（高重要级：到点要能"叫人"，但不强制出声——静音处理） */
function ensureLeisureChannel(ctx: Context): void {
  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
    try {
      let manager = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
      let ch = new NotificationChannel(
        CHANNEL_LEISURE,
        '休闲提醒',
        NotificationManager.IMPORTANCE_HIGH
      )
      ch.setDescription('休闲 App 用太久时提醒你回来专注')
      try { ch.enableVibration(true) } catch (e) {}
      manager.createNotificationChannel(ch)
    } catch (e) {}
  }
}

/** 发一条休闲提醒通知（点击回本 App） */
function postLeisureNotify(ctx: Context, title: string, text: string): boolean {
  try {
    ensureLeisureChannel(ctx)
    let builder = new NotificationCompat.Builder(ctx, CHANNEL_LEISURE)
    builder.setContentTitle(title)
    builder.setContentText(text)
    builder.setSmallIcon(ctx.getApplicationInfo().icon)
    builder.setWhen(System.currentTimeMillis())
    builder.setPriority(1)            // PRIORITY_HIGH
    builder.setCategory('reminder')
    builder.setOnlyAlertOnce(false)
    builder.setOngoing(false)
    builder.setAutoCancel(true)
    let launch = ctx.getPackageManager().getLaunchIntentForPackage(ctx.getPackageName())
    if (launch != null) {
      launch.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TOP)
      let pi = PendingIntent.getActivity(ctx, LEISURE_NOTIFY_ID, launch, piFlags())
      builder.setContentIntent(pi)
    }
    let nm = ctx.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
    nm.notify(LEISURE_NOTIFY_ID, builder.build())
    return true
  } catch (e) {
    return false
  }
}

/** 发一条并把节流状态往前推一格 */
function leisureNotify(ctx: Context, title: string, text: string, kind: string, st: LeisureThrottle): void {
  if (postLeisureNotify(ctx, title, text)) {
    st.count = st.count + 1
    st.kinds.push(kind)
    saveLeisureThrottle(st)
  }
}

/**
 * 核心检测：读当天休闲时长 → 判定 → 节流/静默/去重 → 发通知。
 * 在 receiver 的 onReceive（主线程）里跑，必须快：只做一次 UsageStats 查询 + 一次发通知。
 */
function leisureGuardCheck(ctx: Context): void {
  let c = loadLeisureCfg();
  if (c == null || !c.on) return;
  if (!usageGranted(ctx)) return;                 // 没「使用情况访问」就别瞎提醒
  if (c.pkgs.length == 0) return;
  if (!notifAllowed(ctx)) return;                 // 通知被关掉时别烧节流配额（notify 静默无效）

  let st = loadLeisureThrottle();
  if (st.count >= c.maxPerDay) { saveLeisureThrottle(st); return; }

  if (leisureInQuiet(c, leisureNowHm())) return;  // 静默时段

  let mins = leisureDayUsage(ctx, c.pkgs);
  let total: Int = 0;
  let topIdx: Int = -1;
  let topMin: Int = 0;
  var i: Int = 0;
  while (i < c.pkgs.length) {
    let m = mins[i];
    total = total + m;
    if (m > topMin) { topMin = m; topIdx = i; }
    i++;
  }

  // dwell：现在前台正好是那个休闲 App，且它当日累计已够（"你正在刷抖音"）
  if (topIdx >= 0 && topMin >= c.dwellMin) {
    let fg = queryForeground(ctx);
    if (fg == c.pkgs[topIdx] && st.kinds.indexOf('dwell') < 0) {
      let name = c.names[topIdx];
      let text = leisureTpl(c.dwellMsg, name, topMin, total, c.remaining)
        + leisureTpl(c.dwellTail, name, topMin, total, c.remaining);
      leisureNotify(ctx, c.dwellTitle, text, 'dwell', st);
      return;
    }
  }

  // daily：当天零专注 且 休闲累计够
  if (total >= c.dailyMin && !leisureFocusToday() && st.kinds.indexOf('daily') < 0) {
    let text = leisureTpl(c.dailyMsg, '', total, total, c.remaining);
    leisureNotify(ctx, c.dailyTitle, text, 'daily', st);
    return;
  }

  // digest：复盘开关开 且 已过复盘时点
  if (c.digest && leisurePastDigest(c) && st.kinds.indexOf('digest') < 0) {
    let text = leisureTpl(c.digestMsg, '', total, total, c.remaining);
    leisureNotify(ctx, c.digestTitle, text, 'digest', st);
    return;
  }
}

/**
 * 已排的闹钟还算不算数。
 *
 * 为什么要这个：`armGuard()` 每次 App 回前台都会调一次。如果它无脑重排，
 * 用户每 10 分钟切进来一次，闹钟就永远被推到"15 分钟后"，**一次都不会真正到点** ——
 * 典型的"看着挂了其实永不触发"。所以只在没有有效排期时才排。
 *
 * 有效 = SP 里记的下次时点还在未来、且没超出我们的周期太多
 * （超出说明这条排期已经过期/被系统清掉，得重排；进程被杀后重进也走这条路）。
 */
function leisureAlarmFresh(): boolean {
  let p = leisureSp();
  if (p == null) return false;
  let at: Int = p.getInt('leisure_alarm_at', 0);
  if (at <= 0) return false;
  let now = nowSec();
  return at > now && (at - now) <= LEISURE_PERIOD_SEC + 120;
}

/**
 * 排下一次周期闹钟（自续约）。
 *
 * ⚠️⚠️ 一律走**不精确**的 setAndAllowWhileIdle，绝不碰 setExact / setExactAndAllowWhileIdle ⚠️⚠️
 *   安卓 12（API 31）起，精确闹钟要 SCHEDULE_EXACT_ALARM（用户可随时在设置里撤销）
 *   或 USE_EXACT_ALARM（上架要单独报备理由）。我们这个插件**没有**也不该要这两个权限。
 *   缺权限时 setExact* 抛 SecurityException —— 被下面的 catch 吞掉，闹钟永远排不上，
 *   整条后台提醒就静默死掉（界面开关还亮着、日志也不一定有声音），最难查的那种。
 *   而"刷太久提醒"本来就是分钟级语义，晚几分钟完全无所谓，够用了。
 *   setAndAllowWhileIdle 不需要任何权限，Doze 下也能唤醒（系统节流上限约 9~15 分钟，正好）。
 */
function scheduleLeisureAlarm(ctx: Context): void {
  try {
    let am = ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager
    let it = new Intent(ctx, (new LeisureGuard()).javaClass)
    it.setAction(LEISURE_ALARM_ACTION)
    let pi = PendingIntent.getBroadcast(ctx, LEISURE_ALARM_REQ, it, piFlags())
    let t = System.currentTimeMillis() + LEISURE_PERIOD_MS
    if (Build.VERSION.SDK_INT >= 23) {
      am.setAndAllowWhileIdle(0, t, pi)             // 0 = RTC_WAKEUP
    } else {
      am.set(0, t, pi)
    }
    // 记下"下次该醒的秒" —— 供 leisureAlarmFresh 判断要不要重排
    let p = leisureSp();
    if (p != null) p.edit().putInt('leisure_alarm_at', nowSec() + LEISURE_PERIOD_SEC).apply();
  } catch (e) {}
}

/** 撤掉周期闹钟 */
function cancelLeisureAlarm(ctx: Context): void {
  try {
    let am = ctx.getSystemService(Context.ALARM_SERVICE) as AlarmManager
    let it = new Intent(ctx, (new LeisureGuard()).javaClass)
    it.setAction(LEISURE_ALARM_ACTION)
    let pi = PendingIntent.getBroadcast(ctx, LEISURE_ALARM_REQ, it, piFlags())
    am.cancel(pi)
    let p = leisureSp();
    if (p != null) p.edit().putInt('leisure_alarm_at', 0).apply();
  } catch (e) {}
}

/**
 * 系统按清单创建的广播接收器：闹钟到点 / 开机 / 应用更新 都进这里。
 * 自己创建的类同样会被 UTS 的 DCE 剪掉（源码里没人 new 之外的引用），
 * 靠 keepLeisureClass() 钉住（见文件尾）。
 */
class LeisureGuard extends BroadcastReceiver {
  constructor() {
    super();
  }

  override onReceive(ctx: Context, intent: Intent): void {
    try {
      let action = intent.getAction();
      // 开机 / 应用更新：从 SP 里读配置，开着的就重挂周期闹钟
      if (action == 'android.intent.action.BOOT_COMPLETED'
        || action == 'android.intent.action.MY_PACKAGE_REPLACED') {
        let c = loadLeisureCfg();
        if (c != null && c.on && !leisureAlarmFresh()) scheduleLeisureAlarm(ctx!);
        return;
      }
    } catch (e) {}

    // ⚠️ 检测与续约**分开 try**，而且检测在前、续约在后：
    //   这两个调用包在同一个 try 里时，只要检测里有一处越界/空指针，
    //   续约那句就永远执行不到 —— 闹钟链断在这一次，之后再也醒不来，
    //   而日志里可能只有一行没人看的 SecurityException/IndexOutOfBounds。
    //   提醒是锦上添花，**绝不能**因为它炸了就不再醒来（后面还要重新排期、跨天重置）。
    try { leisureGuardCheck(ctx!) } catch (e) {}
    try { scheduleLeisureAlarm(ctx!) } catch (e) {}
  }
}

/* ==================== 对外 API ==================== */

/**
 * 挂上/刷新后台检测：把配置存进 SP 并排第一次周期闹钟。
 * @param payload 见 utils/leisure.js armGuard 的 JSON 结构（含模板与阈值）
 */
export function leisureArm(payload: string): boolean {
  let ctx = UTSAndroid.getAppContext();
  if (ctx == null) return false;
  try {
    let p = leisureSp();
    if (p == null) return false;
    p.edit().putInt('leisure_on', 1).putString('leisure_payload', payload).apply();
    // 只在没有有效排期时才排 —— 每次回前台都重排的话，闹钟会被一路往后推，
    // 用户一频繁切进 App 就永远等不到它到点（见 leisureAlarmFresh 的注释）。
    // 配置是**发通知那一刻**才从 SP 读的，所以不重排也照样吃到最新配置。
    if (!leisureAlarmFresh()) scheduleLeisureAlarm(ctx!);
    return true;
  } catch (e) {
    return false;
  }
}

/** 撤掉后台检测（关功能 / 清空清单时） */
export function leisureDisarm(): boolean {
  let ctx = UTSAndroid.getAppContext();
  try {
    let p = leisureSp();
    if (p != null) p.edit().putInt('leisure_on', 0).apply();
    if (ctx != null) cancelLeisureAlarm(ctx!);
    return true;
  } catch (e) {
    return false;
  }
}

/**
 * 记一次"今天专注过"（SP 里留个 leisure_focus_date）。
 * 原生 daily 规则需要判断"零专注"，但它拿不到 JS 的 pwstore，所以由 App 在
 * 专注完成时推一个日期进来。重复调用只是覆盖当天日期，幂等。
 */
export function leisureMarkFocus(): boolean {
  let p = leisureSp();
  if (p == null) return false;
  try {
    p.edit().putString('leisure_focus_date', leisureDateStr()).apply();
    return true;
  } catch (e) {
    return false;
  }
}

/** 钉住接收器类：UTS 会剪掉"没人引用"的声明，系统创建的类靠这里的 new 保住 */
export function keepLeisureClass(): boolean {
  try {
    let probe = new LeisureGuard();
    return probe != null;
  } catch (e) {
    return false;
  }
}
