<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="io.dcloud.uni_modules.pwstudy_focus">

    <!-- 前台服务本体（Android 9+ 要求） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 的 specialUse 类型配套权限。
         ⚠️ 这里只声明权限、不在 <service> 上写类型，原因见下面 PWFocusService 的注释
         （HBuilderX 内置的 aapt2/android.jar 只到 API 30 级，认不出 specialUse）。
         等编译链升到 API 34+ 后，再把下面注释里的两行一起打开。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 强制模式"把 PWstudy 拉回前台"要用到 moveTaskToFront（普通权限） -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- 拉回的通知带 fullScreenIntent（Android 10+ 靠它把界面直接弹到最前） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 兜底遮罩：后台启动 Activity 被 ROM 拦掉时，用悬浮窗盖住那个 App -->
    <!-- 这一条不是装机即得，要在设置里手动授「显示在其他应用上层」 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 休闲提醒后台检测：开机/应用更新后自动重挂周期闹钟（LeisureGuard 接收器用） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 专注期间挡住别家 App 的通知（番茄ToDo 同款）：
         捕获 + 当场撤下 + 结束时汇总，走系统的「通知使用权」。
         ⚠️ BIND_* 是**服务声明级**权限（不是 uses-permission）：
         真正的开关在「设置 → 通知使用权」，用户亲手给（装机即不得）。
         没授权时 interceptStart() 如实返回 false，我们不会假称已经挡住了。 -->

    <application>
        <!-- ⚠️⚠️ 别给这个 Service 加 android:foregroundServiceType="specialUse" ⚠️⚠️
             官方写法是对的（Android 14+ 就该这么声明），但 HBuilderX 打 UTS 插件时用的
             是它自带的 aapt2 2.19 + android.jar（实测只到 API 30 级），两处都会硬报错：
               · <property> → error: unexpected element <property> found in <service>
               · specialUse → error: 'specialUse' is incompatible with attribute
                              foregroundServiceType (attr) flags [camera, connectedDevice,
                              dataSync, location, mediaPlayback, mediaProjection,
                              microphone, phoneCall]      ← flag 列表里没有 specialUse
             最终 APK 的 compileSdk 是 36，但插件这一步先过不去，所以只能不声明。
             不声明会不会出事？不会 —— "前台服务必须声明类型"这条只对
             targetSdk >= 34 生效，本项目 targetSdk = 28（见 manifest.json，未覆盖即默认），
             前台服务照常跑。运行时侧 index.uts 的 startForeground 也留了降级兜底。

             ★ 什么时候可以打开：把 targetSdkVersion 抬到 34+ 之前，必须先确认
               HBuilderX 的 UTS 编译链已经升到 API 34+，然后把这两行加回来：
                 android:foregroundServiceType="specialUse"
                 <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                           android:value="Focus study timer" />
             否则会出现"编译链不认 → 只能不声明 → targetSdk 34 又强制要声明"的死结。 -->
        <service
            android:name="uts.sdk.modules.pwstudyFocus.PWFocusService"
            android:exported="false" />

        <!-- 无障碍护卫服务（强制模式的"眼睛"与"后台启动许可"）。
             需要用户在系统设置里手动开启，属于运行时授权，不是装机即得。
             它只用来判断"当前前台是哪个应用"，不读屏幕内容、不模拟点击、不吞按键。 -->
        <service
            android:name="uts.sdk.modules.pwstudyFocus.PFGuardService"
            android:exported="true"
            android:label="@string/pw_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pw_accessibility_config" />
        </service>

        <!-- 强制模式"拦截页"（2026-10-15）：逃逸时从看门狗 startActivity 弹出的全屏黑页，
             3 秒倒计时自动跳回计时页（参照番茄ToDo 严格模式实测录像）。
             · exported=false：只有本应用（含同 uid 的服务）能启动它
             · excludeFromRecents + noHistory：最近任务不留痕、按 HOME 即销毁 ——
               不留一个"能绕过强制模式的后门"页面
             · 黑底全屏 theme：它出现的那一瞬就要把底下的 App 整个盖住 -->
        <activity
            android:name="uts.sdk.modules.pwstudyFocus.PWPullActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- 通知监听服务（专注期"拦截通知"）：捕获别家 App 的通知并当场撤下，
             专注结束把攒到的汇总发出来。权限由用户在「通知使用权」设置页亲手给，
             属运行时授权，不是装机即得。只读标题/正文并暂时收起，
             不改别家通知的内容、不回发、不上传。 -->
        <service
            android:name="uts.sdk.modules.pwstudyFocus.PWNotifListener"
            android:exported="true"
            android:label="@string/pw_notif_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 休闲提醒后台检测（LeisureGuard）：AlarmManager 周期闹钟到点 / 开机 / 应用更新
             都进这里，由它读 UsageStats 检测休闲 App 用时并弹提醒。
             · exported=false：只接收系统广播（开机/替换）和我们自己的闹钟 PendingIntent；
             · 闹钟走 RTC_WAKEUP + setExactAndAllowWhileIdle，App 关着也能唤醒；
             · 配置存在本插件 SP 里，receiver 在独立进程被唤醒时也能读到，不依赖 App 主进程。
             注意：本类由系统按清单创建、源码里不被 new（除 keepLeisureClass 钉住），
             UTS 的 DCE 会剪掉"无人引用"的声明，所以 index.uts 里必须保留 keepLeisureClass()。 -->
        <receiver
            android:name="uts.sdk.modules.pwstudyFocus.LeisureGuard"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="io.dcloud.uni_modules.pwstudy_focus.LEISURE_ALARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
