/**
 * pwstudy-focus —— 专注计时前台服务（接口定义）
 *
 * 职责：专注计时开始时启动 Android 前台服务（常驻通知），
 * 保证息屏 / 后台期间进程不被回收，计时与结束提醒不中断。
 *
 * 只有 app-android 实现；H5 / 小程序 / iOS 由 utils/fgsvc.js 降级处理，
 * 调用方永远不直接 import 本插件。
 */
export type FocusServiceState = {
  running: boolean
}

/** 启动前台服务并挂出常驻通知（专注开始时调用；重复调用 = 刷新文案） */
export function startFocusService(title: string, text: string): boolean

/** 只刷新常驻通知的文案（服务已在前台时，倒计时每 30 秒刷一次） */
export function updateFocusNotification(title: string, text: string): boolean

/** 停止前台服务并移除常驻通知（专注结束 / 放弃时调用） */
export function stopFocusService(): boolean

/** 探测插件是否可用（标准基座里没有 UTS 原生代码，调用会失败） */
export function isAvailable(): boolean

/**
 * 强制模式：配置后台看门狗（原生线程，App 退到后台照样盯）。
 *
 * 为什么必须下沉到原生：WebView 里的 setInterval 在 App 退到后台后会被系统挂起，
 * 光靠 JS 轮询会出现"人走了却一直没被拉回"——这就是强制模式失效的直接原因。
 *
 * @param on       是否启用
 * @param allowCsv 白名单包名（英文逗号分隔）：本 App + 系统中性包 + 登记为「学习」的 App
 * @param untilSec 自动收手倒计时（秒，= 本专注剩余时间）；JS 被冻结时靠它兜底
 */
export function setWatch(on: boolean, allowCsv: string, untilSec: Int): boolean

/** 强制模式战绩：已拉回次数 */
export function watchPulls(): number

/** 强制模式战绩：逃逸次数（连续离开学习 App 的"次"） */
export function watchEscapes(): number

/** 清零战绩（每轮专注开始时调一次） */
export function resetWatchStats(): boolean

/**
 * 强制模式用：把 PWstudy 自己拉回前台。
 * 优先 moveTaskToFront（复用已有 task，专注页状态不丢），失败再退回 launch intent。
 * 被系统 / ROM 拦住时返回 false —— 调用方会升级成悬浮窗遮罩。
 */
export function bringToFront(): boolean

/** 有没有"拉回前台"的原生能力（标准基座返回 false） */
export function bringToFrontSupported(): boolean

/**
 * 前台服务现在是否真的活着（看门狗的载体）。
 * 服务被系统回收后 JS 侧仍记着"推过配置"，于是原生和 JS 兜底两头都不盯人 ——
 * 拿这个真值做自愈判断（见 utils/forced.js 的 pushConfig）。
 */
export function serviceAlive(): boolean

/** 原生侧实测的「显示在其他应用上层」（悬浮窗）权限 */
export function overlayGranted(): boolean

/** 强制模式自检快照（JSON 字符串）：把链路上每一环的实测值一次交出来 */
export function watchDiag(): string

/* ==================== 无障碍护卫（强制模式的能力前提） ====================
 *
 * ⚠️⚠️ 这里有一条 2026-10-14 纠正掉的**错误结论**，别再照着它改回去 ⚠️⚠️
 *
 *   旧版注释写的是"官方豁免清单里列了'由系统绑定的服务（无障碍…）'这一类，
 *   所以无障碍服务 startActivity 才拉得动"。这是**错的**，而且它正是强制模式
 *   连着好几轮"看着完全没反应"的根源（每一次都基于它去加固，越加固越错）。
 *
 *   官方《Activity security》里后台启动的豁免是这几条：
 *     · 有可见窗口（在前台）/ 是输入法
 *     · **有 SYSTEM_ALERT_WINDOW 权限**      ← 唯一对我们有用的那条
 *     · 有 START_ACTIVITIES_FROM_BACKGROUND 特权（系统应用）
 *     · **被"另一个可见应用"的服务绑定**      ← 注意是"别的 App"，不是自己的服务
 *     · 系统发的 PendingIntent（通知点击 / fullScreenIntent）
 *   无障碍服务是我们**自己这个 App** 的组件，不构成"被另一个可见应用绑定"，
 *   所以 PFGuardService.startActivity() 在安卓 10+ 一样被 AMS 静默拦掉
 *   （logcat 里只有一行 "Background activity start ... blocked"，**不抛异常**）。
 *
 *   纠正后的能力定位：
 *     ・**悬浮窗（SYSTEM_ALERT_WINDOW）是唯一可靠的一层**：
 *         ① 它自己就能盖住那个 App（用户点不到）；
 *         ② 更关键的是——拿到它之后，上面豁免清单里的第二条成立，
 *            startActivity / moveTaskToFront 这一串才真的被放行。
 *         所以它是强制模式的**准入条件**，不是"可选兜底"
 *         （同类开源项目 focus-lock 的 README 写的正是同一句："悬浮窗必需，
 *           安卓 10 以后禁止应用在后台自己弹界面，没有这个权限到点不会自动全屏弹出"）。
 *     ・无障碍服务的真正价值只剩一条：**它是"眼睛"** ——
 *         窗口事件由系统直推，比轮询 UsageStats 更快更准，且不用额外授权。
 *     ・fullScreenIntent 只在**锁屏 / 息屏**时才全屏；用户亮屏刷别的 App 时
 *         它只会弹一条横幅，拉不回来。
 *
 * 两个服务同进程，共享同一份白名单与逃逸计数（判定只在 PWFocusService.seen() 里做一次）。
 */

/** 无障碍护卫在系统里是否已开启（用户在设置里勾上了） */
export function a11yEnabled(): boolean

/** 护卫当前是否已连上（系统绑定成功，正在收窗口事件） */
export function a11yActive(): boolean

/** 护卫累计收到的窗口事件数（诊断 / 界面显示"它确实在干活"） */
export function a11yEvents(): number

/** 护卫最近报上来的前台包名（空串 = 还没报过） */
export function a11yPkg(): string

/**
 * 跳系统的「无障碍」设置页。
 * ⚠️ 安卓 13+ 对侧载安装的应用有「受限设置」闸门，用户需先允许受限设置才能勾上本服务。
 */
export function openA11ySettings(): boolean

/**
 * 保险丝有没有跳过闸。
 *
 * 无障碍服务是系统绑的，绑定过程中一旦抛异常，系统会"杀进程 → 重 bind → 再崩"循环，
 * 表现是 APP 和整机一起卡死。所以插件内部数着窗口期内的 bind 次数，超了就彻底躺平
 * （服务变成空壳，不再碰任何状态、不再收事件）。返回 false = 已经躺平了，
 * 界面要如实告诉用户"这个 ROM 上起不来，用严格模式 / 悬浮窗那一档"，并给"再试一次"。
 */
export function a11ySafe(): boolean

/** 重置保险丝（设置页"再试一次"）：清掉 bind 计数，下一次被系统 bind 时重新正常初始化 */
export function resetA11y(): boolean

/**
 * ⚠️ 不要当成"没用的函数"删掉 —— 它唯一的作用是把 PFGuardService 钉在编译产物里。
 *
 * UTS 编译器会剪掉"代码里没人引用"的声明，而 PFGuardService 是**系统**按清单创建的，
 * 源码里从来没有 new 过它，于是整个类被剪掉（打出的 dex 里没有这个类，
 * 用户在系统设置里打开开关只会拿到 ClassNotFoundException）。
 * 实现里 new 一次为的就是这个编译期引用，不产生任何运行时副作用。
 * JS 侧不需要调用它。
 */
export function keepGuardClass(): boolean

/**
 * ⚠️ 同 keepGuardClass：把 PWNotifListener（专注期拦截通知的 NotificationListenerService）
 *   钉在编译产物里。它也是系统按清单创建、源码里没人 new 就会整块被剪掉的服务类；
 *   实现里 new 一次只为编译期引用。与 keepGuardClass 不同，本函数**需要**被 JS 调用
 *   （见 utils/fgsvc.js keepNativeClasses → App.vue onLaunch），否则 PWNotifListener
 *   不在 dex 里，用户在「通知使用权」里打开开关也只有 ClassNotFoundException，
 *   表现就是"消息拦截开了却完全不挡" —— 这正是 2026-10 那版"还是这样"的根因。
 */
export function keepNotifClass(): boolean

/**
 * ==================== 白噪音原生播放（后台不中断）====================
 *
 * 用原生 android.media.MediaPlayer 播循环白噪音，替代 WebView 系
 * 的 uni.createInnerAudioContext（后者在 App 退后台时音频上下文被回收，
 * 会报 errCode -5）。详见 index.uts 顶部该段注释。
 *
 * 仅在自定义基座（APP-PLUS + 插件可用）下有意义；标准基座下
 * utils/ambient.js 会自动回退到 InnerAudioContext。
 */

/** 开始/切换循环播放。absPath 本地 wav 绝对路径；volume 0~1；loop 是否循环。返回 0 成功 */
export function ambientStart(absPath: string, volume: number, loop: boolean): number

/** 暂停（保留进度/实例，可 resume） */
export function ambientPause(): void

/** 恢复播放 */
export function ambientResume(): void

/** 停止并释放 */
export function ambientStop(): void

/** 最近一次错误描述（空串 = 无错误） */
export function ambientError(): string

/**
 * ==================== 悬浮灵动岛倒计时胶囊 ====================
 *
 * 一条**独立**的悬浮窗（TYPE_APPLICATION_OVERLAY），和强制模式遮罩复用同一套
 * SYSTEM_ALERT_WINDOW 权限与 WindowManager 机制，但**完全解耦**于强制模式：
 * 没开强制模式、甚至没开无障碍，只要用户授了悬浮窗权限并打开了「灵动岛」开关，
 * 胶囊就能在用户离开本 App 时显示专注倒计时。
 *
 * 行为（由 utils/focus.js 的 syncCapsule 统一编排）：
 *   · 仅本 App 在后台（用户在别的应用里）才显示；
 *   · 本 App 在前台时立刻撤掉（前台已有圆盘倒计时，不重复）；
 *   · 点一下胶囊 = 把 PWstudy 拉回前台（复用强制模式的 PullNowTask 拉回链路）；
 *   · 强制模式下用户在「学习 App」里时，也能靠胶囊回前台（给一个不靠遮罩的出口）。
 *
 * 文案由 JS 侧算好传进来（"专注中 24:13" 这种），原生只负责挂/撤/刷新 + 点击拉回。
 */

/** 挂出胶囊（若未授权或已挂则按刷新处理） */
export function showCapsule(text: string, endAt: number, label: string): boolean

/** 刷新胶囊文案与终点（已挂则改字，未挂则先挂） */
export function updateCapsule(text: string, endAt: number, label: string): boolean

/** 撤掉胶囊 */
export function hideCapsule(): boolean

/**
 * ==================== 休闲提醒后台检测（LeisureGuard） ====================
 *
 * 多邻国式提醒的「真·后台」腿：即使 App 关着，也周期读 UsageStats 检测休闲 App
 * 使用时长，并在复盘时点发一条提醒。详见 index.uts 顶部该段注释。
 *
 * payload：utils/leisure.js armGuard 预渲染的 JSON 字符串
 *   { on, pkgs:[], names:[], dwellMin, dailyMin, quietFrom, quietTo,
 *     maxPerDay, digest, digestTime, digestHm, remaining,
 *     dwellTitle, dailyTitle, digestTitle, dwellMsg, dwellTail, dailyMsg, digestMsg }
 *   注意 digestHm 是「小时*60+分钟」的整数，原生只用它做比较——原生侧不解析
 *   "20:00" 这种字符串（Number() 在生成的 Kotlin 里会编不过）。
 * 返回 true = 已挂上/刷新定时任务。
 */
export function leisureArm(payload: string): boolean

/** 撤掉后台检测（关功能 / 清空清单时） */
export function leisureDisarm(): boolean

/**
 * 记一次"今天专注过"（SP 里存 leisure_focus_date）。
 * 原生 daily 规则据此判断"零专注"；JS 在专注完成时调用。
 */
export function leisureMarkFocus(): boolean
